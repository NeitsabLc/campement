{% set prefix = modifiable ? '' : 'lignes[' ~ index ~ ']' %}
{% set valeurDenree = ligneValeurs.denree|default('') %}
<div class="movement-line" data-stock-movement-target="line">
    <div class="movement-line-food">
        <label>Denrée <b>*</b><select name="{{ prefix ? prefix ~ '[denree]' : 'denree' }}" required data-controller="searchable-select" data-line-food data-action="change->stock-movement#refreshLine"><option value="">Sélectionner une denrée</option>{% for denree in denreesActives %}<option value="{{ denree.id }}" data-suppliers="{% for reference in referencesParDenree[denree.id ~ '']|default([]) %}{{ reference.fournisseur.id }} {% endfor %}"{{ valeurDenree == denree.id ~ '' ? ' selected' : '' }}>{{ denree.nom }}</option>{% endfor %}</select></label>
    </div>
    <div class="movement-line-detail" data-line-exit>
        <div class="stock-movement-grid">
            <label>Conditionnement <b>*</b><select name="{{ prefix ? prefix ~ '[conditionnement_sortie]' : 'conditionnement_sortie' }}" data-line-exit-unit data-action="change->stock-movement#refreshLine"><option value="">Sélectionner un conditionnement</option>{% for denreeId, liste in conditionnementsSortieParDenree %}{% for unite in liste %}<option value="{{ unite.id }}" data-food="{{ denreeId }}" data-symbol="{{ unite.symbole }}"{{ ligneValeurs.conditionnement_sortie|default('') == unite.id ~ '' ? ' selected' : '' }}>{{ unite.nom }}</option>{% endfor %}{% endfor %}</select></label>
            <label>Quantité <b>*</b><div class="movement-quantity"><input name="{{ prefix ? prefix ~ '[quantite]' : 'quantite' }}" value="{{ ligneValeurs.quantite|default('') }}" inputmode="decimal" placeholder="0" data-line-quantity><span data-line-unit>—</span></div></label>
        </div>
    </div>
    <div class="movement-line-detail" data-line-entry hidden>
        <select name="{{ prefix ? prefix ~ '[reference]' : 'reference' }}" data-line-reference hidden><option value="">Aucune référence</option>{% for denreeId, liste in referencesParDenree %}{% for reference in liste %}<option value="{{ reference.id }}" data-food="{{ denreeId }}" data-supplier="{{ reference.fournisseur.id }}"{{ ligneValeurs.reference|default('') == reference.id ~ '' ? ' selected' : '' }}>{{ reference.fournisseur.nom }}</option>{% endfor %}{% endfor %}</select>
        {% for referenceId, liste in conditionnementsParReference %}<div class="movement-packagings" data-line-packagings data-reference="{{ referenceId }}" hidden><h3>Quantités reçues par conditionnement</h3><div class="movement-packaging-grid">{% for conditionnement in liste %}<label><span>{{ conditionnement.libelle }}</span><input name="{{ prefix ? prefix ~ '[conditionnements][' ~ conditionnement.id ~ ']' : 'conditionnements[' ~ conditionnement.id ~ ']' }}" value="{{ ligneValeurs.conditionnements[conditionnement.id ~ '']|default('') }}" inputmode="decimal" min="0" placeholder="0"><small>1 {{ conditionnement.libelle }} contient {{ conditionnement.quantiteContenu|number_format(3, ',', ' ')|replace({',000': ''}) }} {{ conditionnement.libelleContenu ?: (conditionnement.uniteContenu ? conditionnement.uniteContenu.symbole : 'unité(s)') }}</small></label>{% endfor %}</div></div>{% endfor %}
        <p class="movement-no-supplier" data-line-no-supplier hidden>Aucun fournisseur actif n’est associé à cette denrée.</p>
    </div>
    <div class="movement-lot" data-line-lot hidden>
        <label><span>Numéro de lot</span><div class="movement-lot-input"><input type="text" name="{{ prefix ? prefix ~ '[numero_lot]' : 'numero_lot' }}" value="{{ ligneValeurs.numero_lot|default('') }}" maxlength="100" autocomplete="off" placeholder="Ex. L240731A" data-line-lot-value><button type="button" class="food-secondary" data-action="stock-movement#scanLot">Scanner le lot</button></div><small data-line-lot-status>Le résultat du scan reste modifiable avant l’enregistrement.</small></label>
        <input type="file" accept="image/*" capture="environment" data-line-lot-camera data-action="change->stock-movement#readLotImage" hidden>
    </div>
    <div class="movement-line-action">{% if not modifiable %}<button type="button" class="movement-remove-line" data-action="stock-movement#removeLine" aria-label="Retirer cette denrée">Retirer</button>{% endif %}</div>
</div>
