{% extends 'base.html.twig' %}
{% block title %}Mouvements de stock | Campement{% endblock %}
{% block body %}
<main class="stock-list-page entity-list-page" data-controller="stock-list">
    <header class="stock-list-heading entity-list-heading"><div><h1>Mouvements de stock</h1></div><a class="food-primary food-add-button" href="{{ path('app_mouvement_stock') }}" aria-label="Ajouter un mouvement"><span aria-hidden="true">＋</span><span class="food-add-button__label">Ajouter un mouvement</span></a></header>
    {% for message in app.flashes('success') %}<div class="stock-movement-success" role="status" data-auto-dismiss>✓ {{ message }}</div>{% endfor %}
    <section class="stock-list-card">
        {% if not sejour %}<div class="stocks-empty"><strong>Aucun séjour actif</strong><p>La liste des mouvements est indisponible.</p></div>
        {% elseif mouvements is empty %}<div class="stocks-empty"><strong>Aucun mouvement enregistré</strong><p>Commencez par saisir une entrée ou une sortie de stock.</p><a class="food-primary" href="{{ path('app_mouvement_stock') }}">Ajouter un mouvement</a></div>
        {% else %}<div class="stock-list-table">
            <div class="stock-list-row stock-list-row--head"><span>Date</span><span>Type</span><span>Denrées</span><span>Origine</span><span>Fournisseur / groupe</span><span></span></div>
            {% for groupeMouvement in mouvements %}{% set mouvement = groupeMouvement.mouvement %}{% set premiereLigne = groupeMouvement.lignes|first %}<div class="stock-swipe-row"{% if not mouvement.annule %} data-controller="swipe-actions" data-swipe-actions-url-value="{{ path('app_mouvement_stock_modifier', {id: mouvement.id, ligne: premiereLigne.id}) }}"{% endif %}>
                {% if not mouvement.annule %}<a class="stock-swipe-action" href="{{ path('app_mouvement_stock_annuler', {id: mouvement.id}) }}" data-swipe-actions-target="action">Annuler</a>{% endif %}
                <article class="stock-list-row{{ not mouvement.annule ? ' clickable-row' : '' }}"{% if not mouvement.annule %} role="link" tabindex="0" data-swipe-actions-target="surface" data-action="pointerdown->swipe-actions#start pointermove->swipe-actions#move pointerup->swipe-actions#end pointercancel->swipe-actions#cancel click->swipe-actions#activate keydown->swipe-actions#activate"{% endif %}>
                <span class="stock-list-primary"><time datetime="{{ mouvement.dateMouvement|date('c') }}">{{ mouvement.dateMouvement|date('d/m/Y H:i') }}</time></span>
                <span><span class="movement-badge movement-badge--{{ mouvement.typeMouvement.code|lower }}">{{ mouvement.typeMouvement.libelle }}</span>{% if mouvement.annule %} <span class="status-pill status-pill--inactive">Annulé</span>{% endif %}</span>
                <strong>{{ groupeMouvement.lignes|length }} {{ groupeMouvement.lignes|length > 1 ? 'denrées' : 'denrée' }}</strong>
                <span>{{ mouvement.origineMouvement.libelle }}</span>
                <span>{{ groupeMouvement.intervenant }}</span>
                <span class="food-actions">{% if not mouvement.annule %}<a class="stock-edit-button" href="{{ path('app_mouvement_stock_modifier', {id: mouvement.id, ligne: premiereLigne.id}) }}" aria-label="Modifier le mouvement du {{ mouvement.dateMouvement|date('d/m/Y') }}" title="Modifier le mouvement"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 20h4l11-11-4-4L4 16v4Zm13.5-16.5 3 3a1.4 1.4 0 0 1 0 2L19 10l-5-5 1.5-1.5a1.4 1.4 0 0 1 2 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span class="visually-hidden">Modifier le mouvement</span></a><a class="button-link" href="{{ path('app_mouvement_stock_annuler', {id: mouvement.id}) }}">Annuler</a>{% endif %}</span>
                </article>
            </div>{% endfor %}
        </div>{% endif %}
    </section>
    {% if audits %}<section class="stock-list-card"><header class="object-list-summary"><h2>Historique des opérations</h2><p>100 dernières opérations auditées</p></header><div class="management-list">{% for audit in audits %}<article class="management-card"><div class="management-card__main"><span class="status-pill">{{ audit.action|lower|capitalize }}</span><h3>Mouvement {{ audit.mouvement_stock_id }}</h3><p>{{ audit.motif }}</p><small>{{ audit.utilisateur_libelle }} · {{ audit.created_at|date('d/m/Y H:i') }}</small></div></article>{% endfor %}</div></section>{% endif %}
</main>
{% endblock %}
