{% extends 'base.html.twig' %}
{% block title %}Annuler un mouvement | Campement{% endblock %}
{% block body %}
<main class="stock-movement-page food-form-page">
    <nav class="food-breadcrumb"><a href="{{ path('app_mouvements_stock') }}">Mouvements de stock</a><span>/</span><span>Annulation</span></nav>
    <header class="stock-movement-heading food-form-heading"><div><h1>Annuler le mouvement</h1></div></header>
    {% if erreur %}<div class="stock-movement-errors" role="alert"><p>{{ erreur }}</p></div>{% endif %}
    <section class="stock-movement-card food-form-card">
        <h2>Mouvement du {{ mouvement.dateMouvement|date('d/m/Y H:i') }}</h2>
        <p>{{ mouvement.typeMouvement.libelle }} · {{ mouvement.origineMouvement.libelle }}</p>
        <p>Le mouvement restera visible dans le journal, mais son effet sera retiré du calcul du stock.</p>
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('annuler_mouvement_stock_' ~ mouvement.id) }}">
            <label>Motif <b>*</b><textarea name="motif" maxlength="1000" rows="4" required autofocus>{{ app.request.request.get('motif') }}</textarea><small>Ce motif sera conservé dans l’historique d’audit.</small></label>
            <div class="stock-movement-actions"><a class="food-secondary" href="{{ path('app_mouvements_stock') }}">Retour</a><button class="food-primary" type="submit">Confirmer l’annulation</button></div>
        </form>
    </section>
</main>
{% endblock %}
