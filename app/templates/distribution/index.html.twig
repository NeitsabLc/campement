{% extends 'base.html.twig' %}
{% block title %}Distribution | Campement{% endblock %}
{% block body %}
<main class="orders-page entity-list-page">
    <header class="stock-list-heading entity-list-heading"><div><h1>Distribution</h1><p>Quantités à préparer au Scout Market pour chaque repas</p></div></header>
    {% for message in app.flashes('success') %}<div class="flash flash--success" role="status">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="flash flash--error" role="alert">{{ message }}</div>{% endfor %}
    {% if not sejour %}<section class="empty-state"><h2>Aucun séjour actif</h2></section>
    {% else %}<div class="distribution-admin__grid">
        <section class="admin-card distribution-config-card"><div class="admin-card__header"><div><h2>Configuration</h2><p>Réglages du séjour <strong>{{ sejour.nom }}</strong>.</p></div></div><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('configurer_distribution_' ~ sejour.id) }}"><label class="distribution-master"><input type="checkbox" name="distribution_publique_active"{{ sejour.distributionPubliqueActive ? ' checked' : '' }}><span><strong>Saisie publique activée</strong></span></label><label class="distribution-master"><input type="checkbox" name="distribuer_gouter_dejeuner"{{ sejour.distribuerGouterDejeuner ? ' checked' : '' }}><span><strong>Distribuer le goûter lors du déjeuner</strong></span></label><button class="button button--primary" type="submit">Enregistrer la configuration</button></form></section>
        <section class="admin-card public-link-card"><div class="admin-card__header"><div><h2>Page publique Scout Market</h2><p>Lien de saisie des retraits par les unités.</p></div></div><div class="public-link-copy"><input readonly value="{{ lien_public }}" data-distribution-admin-target="link" aria-label="Lien public de distribution"></div><div class="distribution-qr"><img src="{{ path('app_distribution_qr_code', {jeton: sejour.jetonDistributionPublique}) }}" alt="QR code vers la page publique de distribution"><a class="button button--secondary" href="{{ lien_public }}" target="_blank" rel="noopener">Ouvrir la page</a></div><form method="post" class="renew-link-form"><input type="hidden" name="_token" value="{{ csrf_token('configurer_distribution_' ~ sejour.id) }}"><input type="hidden" name="action" value="renouveler"><button class="button button--danger-outline" type="submit">Générer un nouveau lien</button></form></section>
        <section class="admin-card shopping-lists-card"><div class="admin-card__header"><div><h2>Listes de course</h2><p>Fiches par repas et par unité.</p></div></div><div class="flash" role="status" aria-live="polite" hidden data-distribution-admin-target="downloadStatus"></div><button class="button button--primary" type="button" data-open-dialog="shopping-lists-period">Télécharger les listes de course</button></section>
    </div>
    <dialog class="group-dialog export-period-dialog" id="shopping-lists-period" aria-labelledby="shopping-lists-period-title"><section class="group-dialog__content"><header class="group-dialog__header"><div><h2 id="shopping-lists-period-title">Période des fiches à extraire</h2></div><button class="group-dialog__close" type="button" aria-label="Fermer" data-close-dialog>×</button></header><form method="get" action="{{ path('app_distribution_listes_courses') }}" data-action="submit->distribution-admin#download"><div class="export-period-fields"><label for="shopping-lists-start">Date de début<input id="shopping-lists-start" type="date" name="date_debut" value="{{ 'now'|date('Y-m-d') }}" min="{{ sejour.dateDebut|date('Y-m-d') }}" max="{{ sejour.dateFin|date('Y-m-d') }}" required></label><label for="shopping-lists-end">Date de fin<input id="shopping-lists-end" type="date" name="date_fin" value="{{ sejour.dateFin|date('Y-m-d') }}" min="{{ sejour.dateDebut|date('Y-m-d') }}" max="{{ sejour.dateFin|date('Y-m-d') }}" required></label></div><footer class="group-dialog__actions"><button class="cancel-group-button" type="button" data-close-dialog>Annuler</button><button class="save-group-button" type="submit" data-distribution-admin-target="downloadButton">Télécharger les fiches</button></footer></form></section></dialog>
    <p class="order-calculation-note">Le calcul utilise l’unique menu du séjour. Il applique pour chaque unité présente le menu normal, Explo ou pique-nique défini sur sa fiche, exclut les repas non pris et tient compte des besoins alimentaires.</p>
    {% if commandes is empty %}<section class="stock-list-card"><div class="stocks-empty"><strong>Aucun repas à distribuer</strong><p>Ajoutez des denrées aux menus à venir pour afficher les besoins.</p></div></section>
    {% else %}<div class="orders-list">
        {% for commande in commandes %}{% set menu = commande.menu %}<details class="order-meal-card">
            <summary><h2><time datetime="{{ menu.dateMenu|date('Y-m-d') }}">{{ menu.dateMenu|date('d/m/Y') }}</time> — {{ menu.libelle }}</h2><span class="order-meal-card__meta"><span>{{ commande.lignes|length }} denrée{{ commande.lignes|length > 1 ? 's' : '' }}</span><span class="order-meal-card__chevron" aria-hidden="true">⌄</span></span></summary>
            {% if commande.lignes is empty %}<p class="order-meal-empty">Aucune denrée nécessaire pour ce repas.</p>
            {% else %}<div class="order-table"><table><thead><tr><th scope="col">Denrée</th><th scope="col">Régime</th><th scope="col">Quantité totale</th><th scope="col">Unité</th></tr></thead><tbody>{% for ligne in commande.lignes %}<tr><th scope="row">{{ ligne.denree.nom }}</th><td>{% if ligne.regime %}<span class="diet-badge">{{ ligne.regime.libelle }}</span>{% else %}Standard{% endif %}</td><td class="order-total"><strong>{{ ligne.quantite|quantite }}</strong></td><td>{{ ligne.unite.nom }} ({{ ligne.unite.symbole }})</td></tr>{% endfor %}</tbody></table></div>{% endif %}
        </details>{% endfor %}
    </div>{% endif %}
    {% endif %}
</main>
{% endblock %}
