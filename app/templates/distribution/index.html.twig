{% extends 'base.html.twig' %}
{% block title %}Distribution | Campement{% endblock %}
{% block body %}
<main class="admin-page distribution-admin" data-controller="distribution-admin">
    <header class="page-heading"><div><h1>Distribution</h1></div></header>
    {% for message in app.flashes('success') %}<div class="flash flash--success" role="status">{{ message }}</div>{% endfor %}

    <div class="distribution-admin__grid">
        <section class="admin-card distribution-config-card"><div class="admin-card__header"><div><h2>Configuration</h2><p>Ces réglages concernent le séjour <strong>{{ sejour.nom }}</strong>.</p></div></div>
            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('configurer_distribution_' ~ sejour.id) }}">
                <label class="distribution-master"><input type="checkbox" name="distribution_publique_active"{{ sejour.distributionPubliqueActive ? ' checked' : '' }}><span><strong>Saisie publique activée</strong><small>Le lien public accepte de nouvelles distributions jusqu’au dernier jour du séjour inclus.</small></span></label>
                <label class="distribution-master"><input type="checkbox" name="distribuer_gouter_dejeuner"{{ sejour.distribuerGouterDejeuner ? ' checked' : '' }}><span><strong>Distribuer le goûter lors du déjeuner</strong><small>Le goûter disparaît de la page publique et ses denrées sont ajoutées au déjeuner.</small></span></label>
                <button class="button button--primary" type="submit">Enregistrer la configuration</button>
            </form>
        </section>

        <section class="admin-card public-link-card"><div class="admin-card__header"><div><h2>Page publique de saisie</h2><p>Ce lien reste valable tant qu’il n’est pas renouvelé et jusqu’à la fin du séjour.</p></div><span class="status-badge {{ sejour.distributionPubliqueOuverte ? 'status-badge--active' : 'status-badge--inactive' }}">{{ sejour.distributionPubliqueOuverte ? 'Active' : (sejour.distributionPubliqueActive ? 'Clôturée' : 'Désactivée') }}</span></div>
            <div class="public-link-copy"><input readonly value="{{ lien_public }}" data-distribution-admin-target="link" aria-label="Lien public de distribution"><button type="button" data-action="distribution-admin#copy" data-distribution-admin-target="copyButton">Copier</button></div>
            <div class="distribution-qr"><img src="{{ path('app_distribution_qr_code', {jeton: sejour.jetonDistributionPublique}) }}" alt="QR code vers la page publique de distribution"><div><a class="button button--secondary" href="{{ lien_public }}" target="_blank" rel="noopener">Ouvrir la page</a><a class="button button--secondary" href="{{ path('app_distribution_qr_code', {jeton: sejour.jetonDistributionPublique, telecharger: 1}) }}">Télécharger le QR code</a></div></div>
            <form method="post" class="renew-link-form" onsubmit="return confirm('L’ancien lien cessera immédiatement de fonctionner. Continuer ?')"><input type="hidden" name="_token" value="{{ csrf_token('configurer_distribution_' ~ sejour.id) }}"><input type="hidden" name="action" value="renouveler"><button class="button button--danger-outline" type="submit">Générer un nouveau lien</button></form>
        </section>

        <section class="admin-card shopping-lists-card">
            <div class="admin-card__header"><div><h2>Listes de course</h2><p>Préparez les fiches à remettre aux unités pour chaque repas distribué.</p></div></div>
            <p>L’archive contient un dossier par jour et repas, puis un PDF nominatif par unité participante.</p>
            <a class="button button--primary" href="{{ path('app_distribution_listes_courses') }}">Télécharger les listes de course</a>
        </section>
    </div>
</main>
{% endblock %}
