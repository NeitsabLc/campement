{% extends 'base.html.twig' %}
{% block title %}Registre de présence | Campement{% endblock %}
{% block body %}
<main class="presence-page foods-page">
 <header><div><h1>Registre de présence</h1><p>Journée du {{ dateSelection|date('d/m/Y') }}</p></div><div class="presence-day-nav"><a href="{{ path('app_presence',{date:dateSelection|date_modify('-1 day')|date('Y-m-d')}) }}"{{ dateSelection<=sejour.dateDebut?' aria-disabled="true"':'' }}>←</a><form method="get"><label>Journée<select name="date" onchange="this.form.submit()">{% for date in dates %}<option value="{{ date|date('Y-m-d') }}"{{ date==dateSelection?' selected':'' }}>{{ date|date('d/m/Y') }}</option>{% endfor %}</select></label></form><a href="{{ path('app_presence',{date:dateSelection|date_modify('+1 day')|date('Y-m-d')}) }}"{{ dateSelection>=sejour.dateFin?' aria-disabled="true"':'' }}>→</a><a class="presence-today" href="{{ path('app_presence',{date:aujourdhui|date('Y-m-d')}) }}"{{ not aujourdhuiDansSejour?' aria-disabled="true"':'' }}>Aujourd’hui</a></div></header>
 {% for message in app.flashes('success') %}<div class="flash flash--success" role="status">{{ message }}</div>{% endfor %}{% if erreurs %}<div class="distribution-errors" role="alert">{% for erreur in erreurs %}<p>{{ erreur }}</p>{% endfor %}</div>{% endif %}
 <section class="presence-totals" aria-label="Effectifs présents pour la journée"><div class="presence-total presence-total--young"><strong>{{ totauxPresents.jeunes }}</strong><span>jeune{{ totauxPresents.jeunes > 1 ? 's' : '' }} présent{{ totauxPresents.jeunes > 1 ? 's' : '' }}</span></div><div class="presence-total presence-total--adult"><strong>{{ totauxPresents.adultes }}</strong><span>adulte{{ totauxPresents.adultes > 1 ? 's' : '' }} présent{{ totauxPresents.adultes > 1 ? 's' : '' }}</span></div></section>
 <div class="presence-legend"><span><i class="is-present"></i>Présent</span><span><i class="is-absent"></i>Absent</span><span><i class="is-departed"></i>Parti</span><span><i class="is-outside"></i>Non prévu</span></div>
 {% for groupe in groupes %}
  {% set personnes=participants|filter(p=>p.groupe.id~''==groupe.id~'') %}
  <section class="presence-group">
   <header><h2>{{ groupe.nom }}</h2><span>{{ personnes|filter(p=>jour[p.id~''].statut=='present')|length }} présent(s) sur {{ personnes|length }}</span></header>
   {% if personnes is empty %}<p>Aucun participant.</p>{% else %}
    <div class="presence-daily-list">
     {% for personne in personnes %}
      {% set cellule=jour[personne.id~''] %}{% set exception=cellule.exception %}
      {% set modificationUrl=path('app_presence_modifier',{participantId:personne.id,date:dateSelection|date('Y-m-d')}) %}
      <div class="presence-daily-row{{ cellule.modifiable ? ' clickable-row' : '' }}"{% if cellule.modifiable %} role="link" tabindex="0" data-controller="clickable-row" data-url="{{ modificationUrl }}" data-action="click->clickable-row#open keydown->clickable-row#open"{% endif %}>
       <div><strong>{{ personne.prenom }} {{ personne.nom }}</strong><small>{{ personne.type|title }}</small></div>
       <span class="presence-status is-{{ cellule.statut }}">{{ cellule.statut=='present'?'Présent':(cellule.statut=='absent'?'Absent ce jour':(cellule.statut=='departed'?'A quitté le séjour':'Non prévu')) }}</span>
       <span>{{ exception and exception.commentaire ? exception.commentaire : '' }}</span>
       {% if cellule.modifiable %}<a class="action-icon-button presence-edit-button" href="{{ modificationUrl }}" aria-label="Modifier la présence de {{ personne.prenom }} {{ personne.nom }}" title="Modifier"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 20h4l11-11-4-4L4 16v4Zm13.5-16.5 3 3a1.4 1.4 0 0 1 0 2L19 10l-5-5 1.5-1.5a1.4 1.4 0 0 1 2 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span class="visually-hidden">Modifier</span></a>{% else %}<button class="action-icon-button presence-edit-button" type="button" aria-label="Présence non modifiable pour {{ personne.prenom }} {{ personne.nom }}" title="Non modifiable" disabled><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 20h4l11-11-4-4L4 16v4Zm13.5-16.5 3 3a1.4 1.4 0 0 1 0 2L19 10l-5-5 1.5-1.5a1.4 1.4 0 0 1 2 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></button>{% endif %}
      </div>
     {% endfor %}
    </div>
   {% endif %}
  </section>
 {% endfor %}
</main>
{% endblock %}
