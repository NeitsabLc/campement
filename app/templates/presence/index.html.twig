{% extends 'base.html.twig' %}
{% block title %}Registre de présence | Campement{% endblock %}
{% block body %}
<main class="presence-page" data-controller="presence-grid">
 <header><div><h1>Registre de présence</h1><p>Journée du {{ dateSelection|date('d/m/Y') }}</p></div><div class="presence-day-nav"><a href="{{ path('app_presence',{date:dateSelection|date_modify('-1 day')|date('Y-m-d')}) }}"{{ dateSelection<=sejour.dateDebut?' aria-disabled="true"':'' }}>←</a><form method="get"><label>Journée<select name="date" onchange="this.form.submit()">{% for date in dates %}<option value="{{ date|date('Y-m-d') }}"{{ date==dateSelection?' selected':'' }}>{{ date|date('d/m/Y') }}</option>{% endfor %}</select></label></form><a href="{{ path('app_presence',{date:dateSelection|date_modify('+1 day')|date('Y-m-d')}) }}"{{ dateSelection>=sejour.dateFin?' aria-disabled="true"':'' }}>→</a><a class="presence-today" href="{{ path('app_presence',{date:aujourdhui|date('Y-m-d')}) }}"{{ not aujourdhuiDansSejour?' aria-disabled="true"':'' }}>Aujourd’hui</a></div></header>
 {% for message in app.flashes('success') %}<div class="flash flash--success">{{ message }}</div>{% endfor %}{% if erreurs %}<div class="distribution-errors">{% for erreur in erreurs %}<p>{{ erreur }}</p>{% endfor %}</div>{% endif %}
 <div class="presence-legend"><span><i class="is-present"></i>Présent</span><span><i class="is-absent"></i>Absent</span><span><i class="is-departed"></i>Parti</span><span><i class="is-outside"></i>Non prévu</span></div>
 {% for groupe in groupes %}{% set personnes=participants|filter(p=>p.groupe.id~''==groupe.id~'') %}<section class="presence-group"><header><h2>{{ groupe.nom }}</h2><span>{{ personnes|filter(p=>jour[p.id~''].statut=='present')|length }} présent(s) sur {{ personnes|length }}</span></header>{% if personnes is empty %}<p>Aucun participant.</p>{% else %}<div class="presence-daily-list">{% for personne in personnes %}{% set cellule=jour[personne.id~''] %}{% set exception=cellule.exception %}<div class="presence-daily-row"><div><strong>{{ personne.prenom }} {{ personne.nom }}</strong><small>{{ personne.type|title }}</small></div><span class="presence-status is-{{ cellule.statut }}">{{ cellule.statut=='present'?'Présent':(cellule.statut=='absent'?'Absent ce jour':(cellule.statut=='departed'?'A quitté le séjour':'Non prévu')) }}</span><span>{{ exception and exception.commentaire ? exception.commentaire : '' }}</span><button type="button"{{ not cellule.modifiable?' disabled':'' }} data-action="presence-grid#open" data-id="{{ personne.id }}" data-name="{{ personne.prenom }} {{ personne.nom }}" data-date="{{ dateSelection|date('Y-m-d') }}" data-label="{{ dateSelection|date('d/m/Y') }}" data-status="{{ exception ? exception.statut : 'present' }}" data-comment="{{ exception ? exception.commentaire|default('')|e('html_attr') : '' }}">Modifier</button></div>{% endfor %}</div>{% endif %}</section>{% endfor %}
 <dialog class="presence-dialog" data-presence-grid-target="dialog" data-action="click->presence-grid#backdrop"><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('modifier_presence') }}"><input type="hidden" name="participant_id" data-presence-grid-target="id"><input type="hidden" name="date" data-presence-grid-target="date"><header><div><h2 data-presence-grid-target="name"></h2><p data-presence-grid-target="dateLabel"></p></div><button type="button" data-action="presence-grid#close">×</button></header><fieldset><legend>Statut</legend><label><input type="radio" name="statut" value="present" data-presence-grid-target="status"> Présent</label><label><input type="radio" name="statut" value="absent" data-presence-grid-target="status"> Absent ce jour</label><label><input type="radio" name="statut" value="depart" data-presence-grid-target="status"> A quitté le séjour</label></fieldset><label>Commentaire <span data-presence-grid-target="required"></span><textarea name="commentaire" maxlength="500" rows="3" data-presence-grid-target="comment"></textarea></label><footer><button type="button" data-action="presence-grid#close">Annuler</button><button type="submit">Enregistrer</button></footer></form></dialog>
</main>
{% endblock %}
