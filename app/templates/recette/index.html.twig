{% extends 'base.html.twig' %}
{% block title %}Recettes | Campement{% endblock %}
{% block body %}
<main class="foods-page recipes-page entity-list-page">
    <header class="foods-heading entity-list-heading">
        <div><h1>Recettes</h1></div>
        <a class="food-primary food-add-button" href="{{ path('app_recette_ajouter') }}" aria-label="Ajouter une recette"><span aria-hidden="true">＋</span><span class="food-add-button__label">Ajouter une recette</span></a>
    </header>
    {% for message in app.flashes('success') %}<div class="flash flash--success" role="status">{{ message }}</div>{% endfor %}
    <section class="foods-card recipes-card" data-controller="food-catalog">
        <div class="foods-tools recipes-tools"><label class="food-search"><span aria-hidden="true">⌕</span><span class="visually-hidden">Rechercher</span><input type="search" placeholder="Rechercher une recette…" data-food-catalog-target="search" data-action="input->food-catalog#filter"></label><nav class="food-tabs"><a href="{{ path('app_recettes') }}"{{ actives ? ' aria-current="page"' : '' }}>Actives</a><a class="food-tabs__inactive" href="{{ path('app_recettes',{desactivees:1}) }}"{{ not actives ? ' aria-current="page"' : '' }}>Désactivées</a></nav></div>
        <div class="foods-table" role="table">
            <div class="foods-row recipes-row recipes-row--head" role="row"><span>Recette</span><span>Catégorie</span><span>Composition</span><span>Actions</span></div>
            {% for recette in recettes %}<div data-food-catalog-target="row" data-name="{{ recette.nom|lower }}">
                <div class="foods-swipe-row" data-controller="swipe-actions" data-swipe-actions-url-value="{{ path('app_recette_modifier',{id:recette.id}) }}"><form id="delete-recipe-{{ recette.id }}" class="foods-swipe-action{{ recette.actif ? '' : ' foods-swipe-action--reactivate' }}" method="post" action="{{ path('app_recette_supprimer',{id:recette.id}) }}" data-swipe-actions-target="action"><input type="hidden" name="_token" value="{{ csrf_token('supprimer_recette_'~recette.id) }}"><button type="submit">{{ recette.actif ? 'Désactiver' : 'Réactiver' }}</button></form><div class="foods-row recipes-row clickable-row" role="link" tabindex="0" data-swipe-actions-target="surface" data-action="pointerdown->swipe-actions#start pointermove->swipe-actions#move pointerup->swipe-actions#end pointercancel->swipe-actions#cancel click->swipe-actions#activate keydown->swipe-actions#activate">
                    <strong>{{ recette.nom }}</strong>
                    <span>{{ {'ENTREE':'Entrée','PLAT':'Plat','FROMAGE':'Fromage','DESSERT':'Dessert'}[recette.categorie] }}</span>
                    <span>{{ recette.denrees|length }} denrée{{ recette.denrees|length > 1 ? 's' : '' }}</span>
                    <span class="food-actions">
                        <a class="action-icon-button" href="{{ path('app_recette_modifier', {id: recette.id}) }}" aria-label="Modifier {{ recette.nom }}" title="Modifier">
                            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 20h4l11-11-4-4L4 16v4Zm13.5-16.5 3 3a1.4 1.4 0 0 1 0 2L19 10l-5-5 1.5-1.5a1.4 1.4 0 0 1 2 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                            <span class="visually-hidden">Modifier</span>
                        </a>
                        <button class="{{ recette.actif ? 'action-icon-button action-icon-button--danger' : 'reactivate-food' }}" type="submit" form="delete-recipe-{{ recette.id }}" aria-label="{{ recette.actif ? 'Désactiver' : 'Réactiver' }} {{ recette.nom }}" title="{{ recette.actif ? 'Désactiver' : 'Réactiver' }}">
                            {% if recette.actif %}
                            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span class="visually-hidden">Désactiver</span>
                            {% else %}Réactiver{% endif %}
                        </button>
                    </span>
                </div></div></div>
            {% else %}<div class="foods-empty">Aucune recette.</div>{% endfor %}
        </div>
    </section>
</main>
{% endblock %}
