{% extends 'base.html.twig' %}
{% block title %}{{ recette.nom ? 'Modifier' : 'Ajouter' }} une recette | Campement{% endblock %}
{% block body %}
<main class="food-form-page recipe-form-page" data-controller="recipe-editor">
    <div class="food-breadcrumb"><a href="{{ path('app_recettes') }}">Recettes</a><span>›</span><span>{{ recette.nom ? 'Modifier' : 'Ajouter' }}</span></div>
    <header class="food-form-heading"><div><h1>{{ recette.nom ? 'Modifier la recette' : 'Ajouter une recette' }}</h1></div><div><a href="{{ path('app_recettes') }}" class="food-secondary">Annuler</a><button class="food-primary" type="submit" form="recipe-form">Enregistrer</button></div></header>
    {% if erreurs %}<div class="flash flash--error">{% for e in erreurs %}<p>{{ e }}</p>{% endfor %}</div>{% endif %}
    <form id="recipe-form" method="post"><input type="hidden" name="_token" value="{{ csrf_token('enregistrer_recette') }}">
        <section class="food-form-card"><h2>Informations générales</h2><div class="food-general-grid recipe-name-grid"><label>Nom de la recette <b>*</b><input name="nom" required maxlength="150" value="{{ recette.nom }}"></label></div></section>
        <section class="food-form-card recipe-lines-card"><header><div><h2>Composition</h2><p>Définissez les quantités individuelles pour chaque public.</p></div><button class="food-secondary" type="button" data-action="recipe-editor#add">＋ Ajouter une denrée</button></header>
            <div class="recipe-table" data-public-count="{{ publics|length }}"><div class="recipe-row recipe-row--head"><span>Denrée</span><span>Conditionnement</span>{% for p in publics %}<span>{{ p.publicCible.libelle }}</span>{% endfor %}<span></span></div><div data-recipe-editor-target="rows">
            {% for ligne in recette.denrees %}{% set ri=loop.index0 %}<div class="recipe-row"><select name="lignes[{{ ri }}][denree]" data-controller="searchable-select" data-field="denree" data-action="change->recipe-editor#refresh" required>{% for d in denrees %}<option value="{{ d.id }}"{{ d == ligne.denree ? ' selected' : '' }}>{{ d.nom }}</option>{% endfor %}</select><select name="lignes[{{ ri }}][conditionnement]" data-field="conditionnement" data-selected="{{ ligne.conditionnement.id }}"></select>{% for p in publics %}{% set q='' %}{% for x in ligne.quantites %}{% if x.sejourPublicCible == p %}{% set q=x.quantiteIndividuelle %}{% endif %}{% endfor %}<label><span class="visually-hidden">{{ p.publicCible.libelle }}</span><input name="lignes[{{ ri }}][quantites][{{ p.id }}]" data-public="{{ p.id }}" value="{{ q|replace({'.':','}) }}" required></label>{% endfor %}<button type="button" class="delete-food" data-action="recipe-editor#remove" aria-label="Supprimer la ligne" title="Supprimer"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div>{% endfor %}
            </div></div>
        </section><div class="food-form-actions"><a href="{{ path('app_recettes') }}" class="food-secondary">Annuler</a><button class="food-primary">Enregistrer la recette</button></div>
    </form>
    <template data-recipe-editor-target="template"><div class="recipe-row"><select data-controller="searchable-select" data-field="denree" data-action="change->recipe-editor#refresh" required>{% for d in denrees %}<option value="{{ d.id }}">{{ d.nom }}</option>{% endfor %}</select><select data-field="conditionnement" required></select>{% for p in publics %}<label><span class="visually-hidden">{{ p.publicCible.libelle }}</span><input data-public="{{ p.id }}" required value="0"></label>{% endfor %}<button type="button" class="delete-food" data-action="recipe-editor#remove" aria-label="Supprimer la ligne" title="Supprimer"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div></template>
    <script nonce="{{ app.request.attributes.get('csp_nonce') }}" type="application/json" data-recipe-editor-target="catalog">{{ catalogue|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
</main>
{% endblock %}
