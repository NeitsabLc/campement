{% extends 'base.html.twig' %}
{% block title %}{{ est_administrateur ? 'Séjours' : 'Mes séjours' }} | Campement{% endblock %}
{% block body %}
<main class="stays-page foods-page entity-list-page">
    <header class="stays-heading foods-heading entity-list-heading">
        <div><h1>{{ est_administrateur ? 'Séjours' : 'Mes séjours' }}</h1></div>
        {% if est_administrateur %}<a class="food-primary food-add-button" href="{{ path('app_sejour_ajouter') }}" aria-label="Créer un séjour"><span aria-hidden="true">＋</span><span class="food-add-button__label">Créer un séjour</span></a>{% endif %}
    </header>
    {% for message in app.flashes('success') %}<div class="flash flash--success" role="status">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="flash flash--error" role="alert">{{ message }}</div>{% endfor %}
    {% for erreur in erreurs %}<div class="flash flash--error" role="alert">{{ erreur }}</div>{% endfor %}
    <section class="stays-list-card object-list-card object-detail-list-card">
        <header class="object-list-summary stays-card-heading"><p>{{ sejours|length }} séjour{{ sejours|length > 1 ? 's' : '' }}</p></header>
        <div class="management-list">
        {% for sejour in sejours %}
            <article class="management-card object-detail-row clickable-row{{ not sejour.actif ? ' management-card--inactive' : '' }}" data-controller="clickable-row" data-click-target=".stay-title-link" data-action="click->clickable-row#open">
                <div class="management-card__main">
                    <span class="status-pill {{ sejour.actif ? 'status-pill--active' : '' }}">{{ sejour.actif ? 'Actif' : 'Désactivé' }}</span>
                    <h2><a class="stay-title-link" href="{{ path('app_sejour_modifier', {id: sejour.id}) }}">{{ sejour.nom }}</a></h2>
                    <p>{{ sejour.dateDebut|date('d/m/Y') }} — {{ sejour.dateFin|date('d/m/Y') }}</p>
                    <div class="module-pills"><span class="module-pill{{ not sejour.moduleIntendanceActif ? ' module-pill--off' : '' }}">Intendance</span><span class="module-pill{{ not sejour.moduleAdministratifActif ? ' module-pill--off' : '' }}">Administratif</span></div>
                </div>
                <div class="management-card__actions">
                    {% if sejour.actif %}<form class="stay-selection-form" method="post" action="{{ path('app_sejour_selectionner', {id: sejour.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('selectionner_sejour_' ~ sejour.id) }}"><input type="hidden" name="retour" value="sejours"><button class="button button--primary" type="submit">{{ sejour_selectionne == sejour ? 'Sélectionné' : 'Sélectionner' }}</button></form>{% endif %}
                    {% if est_administrateur %}<a class="button-link stay-duplicate-button" href="{{ path('app_sejour_dupliquer', {id: sejour.id}) }}">Dupliquer</a>{% endif %}
                    <a class="edit-group-button" href="{{ path('app_sejour_modifier', {id: sejour.id}) }}" aria-label="Modifier {{ sejour.nom }}" title="Modifier"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 20h4l11-11-4-4L4 16v4Zm13.5-16.5 3 3a1.4 1.4 0 0 1 0 2L19 10l-5-5 1.5-1.5a1.4 1.4 0 0 1 2 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span class="visually-hidden">Modifier</span></a>
                    {% if sejour.actif %}
                        <button class="delete-group-button stay-delete-button" type="button" data-open-dialog="stay-delete-{{ sejour.id }}" aria-label="Désactiver {{ sejour.nom }}" title="Désactiver"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="stay-delete-button__label">Désactiver</span></button>
                    {% else %}
                        <form class="stay-status-form" method="post" action="{{ path('app_sejour_statut', {id: sejour.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('statut_sejour_' ~ sejour.id) }}"><button class="button-link" type="submit">Réactiver</button></form>
                    {% endif %}
                </div>
            </article>
            {% if sejour.actif %}
            <dialog id="stay-delete-{{ sejour.id }}" class="delete-group-dialog stay-delete-dialog" aria-labelledby="stay-delete-title-{{ sejour.id }}">
                <section class="delete-group-dialog__content">
                    <div class="delete-group-dialog__icon" aria-hidden="true">!</div>
                    <h2 id="stay-delete-title-{{ sejour.id }}">Désactiver ce séjour ?</h2>
                    <p>Les participants, leurs documents, le registre de présence et les situations particulières seront définitivement supprimés.</p>
                    <p class="delete-group-dialog__warning">Les données d’intendance et les unités participantes seront conservées.</p>
                    <form class="stay-status-form" method="post" action="{{ path('app_sejour_statut', {id: sejour.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('statut_sejour_' ~ sejour.id) }}">
                        <input type="hidden" name="confirmation" value="CONFIRMER">
                        <div class="group-dialog__actions">
                            <button class="cancel-group-button" type="button" data-close-dialog>Annuler</button>
                            <button class="confirm-delete-group-button" type="submit">Désactiver le séjour</button>
                        </div>
                    </form>
                </section>
            </dialog>
            {% endif %}
        {% else %}<div class="groups-empty"><strong>Aucun séjour</strong><span>Aucun séjour actif ne vous est actuellement affecté.</span></div>{% endfor %}
        </div>
    </section>
</main>
{% endblock %}
