{% extends 'base.html.twig' %}
{% block title %}Gestion des séjours | Campement{% endblock %}
{% block body %}
<main>
    <header class="page-heading page-heading--actions"><div><h1>Gestion des séjours</h1><p>{{ est_administrateur ? 'Créez, modifiez et gérez l’état des séjours.' : 'Modifiez ou désactivez les séjours qui vous sont confiés.' }}</p></div>{% if est_administrateur %}<button class="button button--primary" type="button" data-open-dialog="sejour-create">Créer un séjour</button>{% endif %}</header>
    {% for message in app.flashes('success') %}<div class="flash flash--success">{{ message }}</div>{% endfor %}
    {% for erreur in erreurs %}<div class="flash flash--error">{{ erreur }}</div>{% endfor %}
    <section class="management-list">
    {% for sejour in sejours %}
        <article class="management-card{{ not sejour.actif ? ' management-card--inactive' : '' }}">
            <div class="management-card__main"><span class="status-pill {{ sejour.actif ? 'status-pill--active' : '' }}">{{ sejour.actif ? 'Actif' : 'Désactivé' }}</span><h2>{{ sejour.nom }}</h2><p>{{ sejour.dateDebut|date('d/m/Y') }} — {{ sejour.dateFin|date('d/m/Y') }}</p><div class="module-pills"><span class="module-pill{{ not sejour.moduleIntendanceActif ? ' module-pill--off' : '' }}">Intendance</span><span class="module-pill{{ not sejour.moduleAdministratifActif ? ' module-pill--off' : '' }}">Administratif</span></div></div>
            <div class="management-card__actions"><button class="edit-group-button" type="button" data-open-dialog="sejour-{{ sejour.id }}" aria-label="Modifier {{ sejour.nom }}" title="Modifier"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 20h4l11-11-4-4L4 16v4Zm13.5-16.5 3 3a1.4 1.4 0 0 1 0 2L19 10l-5-5 1.5-1.5a1.4 1.4 0 0 1 2 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span class="visually-hidden">Modifier</span></button><form method="post" action="{{ path('app_sejour_statut', {id: sejour.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('statut_sejour_' ~ sejour.id) }}">{% if sejour.actif %}<button class="delete-group-button" type="submit" aria-label="Désactiver {{ sejour.nom }}" title="Désactiver"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="visually-hidden">Désactiver</span></button>{% else %}<button class="button-link" type="submit">Réactiver</button>{% endif %}</form></div>
        </article>
        <dialog id="sejour-{{ sejour.id }}" class="app-dialog"><form id="form-sejour-{{ sejour.id }}" method="post" action="{{ path('app_sejours') }}" class="stay-form"><input type="hidden" name="_token" value="{{ csrf_token('enregistrer_sejour') }}"><input type="hidden" name="sejour_id" value="{{ sejour.id }}"><header><h2>Modifier le séjour</h2><button type="button" class="dialog-close" data-close-dialog aria-label="Fermer">×</button></header>{{ include('sejour/_fields.html.twig', {sejour: sejour, creation: false}) }}<footer><button type="button" class="button-link" data-close-dialog>Annuler</button><button class="button button--primary" type="submit">Enregistrer</button></footer></form></dialog>
    {% else %}<div class="empty-state"><h2>Aucun séjour</h2><p>Aucun séjour actif ne vous est actuellement affecté.</p></div>{% endfor %}
    </section>
    {% if est_administrateur %}<dialog id="sejour-create" class="app-dialog"><form id="form-sejour-create" method="post" action="{{ path('app_sejours') }}" class="stay-form"><input type="hidden" name="_token" value="{{ csrf_token('enregistrer_sejour') }}"><header><h2>Créer un séjour</h2><button type="button" class="dialog-close" data-close-dialog aria-label="Fermer">×</button></header>{{ include('sejour/_fields.html.twig', {sejour: null, creation: true}) }}<label>Gestionnaire initial<select name="gestionnaire" required><option value="">Sélectionner</option>{% for gestionnaire in gestionnaires %}<option value="{{ gestionnaire.id }}">{{ gestionnaire.prenom }} {{ gestionnaire.nom }}</option>{% endfor %}</select></label><footer><button type="button" class="button-link" data-close-dialog>Annuler</button><button class="button button--primary" type="submit">Créer</button></footer></form></dialog>{% endif %}
</main>
{% endblock %}
