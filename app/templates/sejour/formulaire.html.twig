{% extends 'base.html.twig' %}
{% block title %}{{ sejour_formulaire ? sejour_formulaire.nom : 'Ajouter un séjour' }} | Campement{% endblock %}
{% block body %}
<main class="food-form-page">
    <nav class="food-breadcrumb"><a href="{{ path('app_sejours') }}">Séjours</a><span>/</span><span>{{ sejour_formulaire ? sejour_formulaire.nom : 'Ajouter' }}</span></nav>
    <header class="food-form-heading"><div><h1>{{ sejour_formulaire ? sejour_formulaire.nom : 'Ajouter un séjour' }}</h1></div></header>
    {% for erreur in erreurs %}<div class="flash flash--error" role="alert">{{ erreur }}</div>{% endfor %}
    <form id="stay-form" method="post" class="stay-form"{% if source_duplication %} action="{{ path('app_sejour_ajouter') }}"{% endif %}><section class="food-form-card"><h2>Informations générales</h2>
        <input type="hidden" name="_token" value="{{ csrf_token('enregistrer_sejour') }}">{% if sejour_formulaire %}<input type="hidden" name="sejour_id" value="{{ sejour_formulaire.id }}">{% endif %}{% if source_duplication %}<input type="hidden" name="source_id" value="{{ source_duplication.id }}">{% endif %}
        {{ include('sejour/_fields.html.twig', {sejour: sejour_formulaire ?? source_duplication, creation: not sejour_formulaire}) }}
    </section>{% if source_duplication %}<section class="food-form-card"><h2>Données à reprendre de « {{ source_duplication.nom }} »</h2><p>Vous pouvez sélectionner plusieurs catégories.</p><div class="checkbox-grid"><label class="check-card"><input type="checkbox" name="duplication[]" value="fournisseurs"> Fournisseurs</label><label class="check-card"><input type="checkbox" name="duplication[]" value="denrees"> Denrées</label><label class="check-card"><input type="checkbox" name="duplication[]" value="recettes"> Recettes</label><label class="check-card"><input type="checkbox" name="duplication[]" value="menus"> Menus</label><label class="check-card"><input type="checkbox" name="duplication[]" value="inventaire"> État d’inventaire actuel</label></div><small>Les dépendances nécessaires (par exemple les denrées d’une recette) seront également reprises.</small>
    </section>{% endif %}<div class="food-form-actions"><a class="food-secondary" href="{{ path('app_sejours') }}">Annuler</a><button class="food-primary" type="submit">Enregistrer le séjour</button></div></form>
</main>
{% endblock %}
