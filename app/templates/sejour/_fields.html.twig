<div class="form-grid"><label>Nom<input name="nom" maxlength="150" value="{{ sejour ? sejour.nom : '' }}" required></label><label>Date de début<input type="date" name="date_debut" value="{{ sejour ? sejour.dateDebut|date('Y-m-d') : '' }}" required></label><label>Date de fin<input type="date" name="date_fin" value="{{ sejour ? sejour.dateFin|date('Y-m-d') : '' }}" required></label></div>
<fieldset><legend>Types de public</legend><div class="checkbox-grid">{% for public in publics %}{% set assoc = sejour ? sejour.publicsCibles|filter(a => a.publicCible == public and a.actif)|length : 0 %}<label class="check-card"><input type="checkbox" name="publics[]" value="{{ public.id }}"{{ assoc ? ' checked' : '' }}> {{ public.libelle }}</label>{% endfor %}</div></fieldset>
<fieldset><legend>Modules actifs</legend><div class="checkbox-grid"><label class="check-card"><input type="checkbox" name="module_intendance"{{ not sejour or sejour.moduleIntendanceActif ? ' checked' : '' }}> <span><strong>Intendance</strong><small>Menus, denrées, fournisseurs et stocks</small></span></label><label class="check-card"><input type="checkbox" name="module_administratif"{{ not sejour or sejour.moduleAdministratifActif ? ' checked' : '' }}> <span><strong>Administratif</strong><small>Participants et gestion administrative</small></span></label></div></fieldset>
