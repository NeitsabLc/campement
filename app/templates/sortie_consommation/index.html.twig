{% extends 'base.html.twig' %}

{% block title %}Distribution des denrées | Campement{% endblock %}
{% block body_class %}distribution-shell{% endblock %}

{% block body %}
<main class="distribution-page" data-controller="distribution">
    <header class="distribution-header">
        <img src="{{ asset('images/logo-sgdf-horizontal.png') }}" alt="Scouts et Guides de France">
        <strong>Campement</strong>
    </header>

    <div class="distribution-content">
        {% if not sejour %}
            <section class="distribution-empty"><h1>Distribution indisponible</h1><p>Aucun séjour actif n’est configuré.</p></section>
        {% elseif groupes is empty or menus is empty %}
            <section class="distribution-empty"><h1>Distribution indisponible</h1><p>{{ groupes is empty ? 'Aucun groupe actif n’est disponible.' : 'Aucun menu n’est encore renseigné.' }}</p></section>
        {% elseif selection %}
            <a class="distribution-back" href="{{ path('app_sortie_consommation', {jeton: sejour.jetonDistributionPublique}) }}">← Modifier la saisie</a>
            <div class="distribution-title"><h1>Vérifiez la distribution</h1><p>Cette opération sera définitive après confirmation.</p></div>
            <section class="distribution-summary">
                <dl><div><dt>Groupe</dt><dd>{{ selection.groupe.nom }}</dd></div><div><dt>Date</dt><dd>{{ selection.menu.dateMenu|date('d/m/Y') }}</dd></div><div><dt>Repas</dt><dd>{{ selection.menu.sejourTypeRepas.typeRepas.libelle }}</dd></div></dl>
                <h2>Quantités distribuées</h2>
                <div class="summary-lines">
                    {% for ligne in selection.menu.denrees %}
                        {% set valeur = selection.quantites[ligne.denree.id ~ ''] %}
                        <div><strong>{{ ligne.denree.nom }}</strong><span>{{ valeur|number_format(3, ',', ' ')|replace({',000': ''}) }} {{ ligne.denree.uniteReference.symbole }}</span></div>
                    {% endfor %}
                </div>
            </section>
            <form method="post" class="confirmation-form" data-turbo="false">
                <input type="hidden" name="_token" value="{{ csrf_token('sortie_consommation') }}">
                <input type="hidden" name="action" value="confirmer">
                <input type="hidden" name="groupe" value="{{ selection.groupe.id }}">
                <input type="hidden" name="menu" value="{{ selection.menu.id }}">
                {% for id, quantite in selection.quantites %}<input type="hidden" name="quantites[{{ id }}]" value="{{ quantite }}">{% endfor %}
                <button class="distribution-button" type="submit">Confirmer la distribution</button>
            </form>
        {% else %}
            <div class="distribution-title"><h1>Distribution</h1><p>Saisissez les denrées prises par votre groupe</p></div>
            {% if erreurs %}<div class="distribution-errors" role="alert">{% for erreur in erreurs %}<p>{{ erreur }}</p>{% endfor %}</div>{% endif %}

            <form method="post" novalidate data-turbo="false">
                <input type="hidden" name="_token" value="{{ csrf_token('sortie_consommation') }}">
                <div class="distribution-selectors">
                    <label>Groupe<select name="groupe" required data-distribution-target="group" data-action="change->distribution#rememberGroup"><option value="">Sélectionner un groupe</option>{% for groupe in groupes %}<option value="{{ groupe.id }}"{{ groupe_soumis == groupe.id ~ '' ? ' selected' : '' }}>{{ groupe.nom }}</option>{% endfor %}</select></label>
                    {% set dates = [] %}
                    <label>Date<select required data-distribution-target="date" data-action="change->distribution#refreshMeals" data-selected="{{ date_soumise }}">
                        {% for menu in menus %}{% set date = menu.dateMenu|date('Y-m-d') %}{% if date not in dates %}<option value="{{ date }}">{{ menu.dateMenu|date('d/m/Y') }}</option>{% set dates = dates|merge([date]) %}{% endif %}{% endfor %}
                    </select></label>
                    <label>Repas<select name="menu" required data-distribution-target="menu" data-action="change->distribution#showMenu" data-selected="{{ menu_soumis }}"><option value="">Sélectionner un repas</option>{% for menu in menus %}<option value="{{ menu.id }}" data-date="{{ menu.dateMenu|date('Y-m-d') }}">{{ menu.sejourTypeRepas.typeRepas.libelle }}</option>{% endfor %}</select></label>
                </div>

                {% for menu in menus %}
                    <section class="distribution-menu" data-distribution-target="menuBlock" data-menu-id="{{ menu.id }}" hidden>
                        <p class="distribution-count"><span>✓</span>{{ menu.denrees|length }} denrée{{ menu.denrees|length > 1 ? 's' : '' }} à renseigner</p>
                        {% for ligne in menu.denrees %}
                            <article class="distribution-food">
                                <div class="distribution-food__heading"><h2>{{ ligne.denree.nom }}</h2><span>{{ ligne.denree.uniteReference.nom }}</span></div>
                                <h3>Portions indicatives</h3>
                                <div class="portion-grid">
                                    {% for quantite in ligne.quantites %}
                                        {% if quantite.sejourPublicCible.actif and quantite.sejourPublicCible.publicCible.actif and quantite.quantiteIndividuelle + 0 > 0 %}<span class="portion-grid__item"><strong>{{ quantite.sejourPublicCible.publicCible.libelle }}</strong>{{ quantite.quantiteIndividuelle|number_format(3, ',', ' ')|replace({',000': ''}) }} {{ ligne.denree.uniteReference.symbole }}</span>{% endif %}
                                    {% endfor %}
                                </div>
                                <label class="total-field">Quantité totale distribuée<div><input name="quantites[{{ ligne.denree.id }}]" value="{{ valeurs[ligne.denree.id ~ '']|default('') }}" inputmode="decimal" required placeholder="0" aria-label="Quantité totale de {{ ligne.denree.nom }}"><span>{{ ligne.denree.uniteReference.symbole }}</span></div></label>
                            </article>
                        {% endfor %}
                    </section>
                {% endfor %}
                <div class="distribution-action"><button class="distribution-button" type="submit">Vérifier la distribution</button></div>
            </form>
        {% endif %}
    </div>
</main>
{% endblock %}
