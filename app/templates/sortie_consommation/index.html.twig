{% extends 'base.html.twig' %}{% block title %}Distribution des denrées | Campement{% endblock %}{% block body_class %}distribution-shell{% endblock %}{% block body %}
<main class="distribution-page" data-controller="distribution"><header class="distribution-header"><img src="{{ asset('images/logo-sgdf-horizontal.png') }}" alt="Scouts et Guides de France"><strong>Campement</strong></header><div class="distribution-content">
{% if not sejour %}<section class="distribution-empty"><h1>Distribution indisponible</h1></section>{% elseif groupes is empty or menus is empty %}<section class="distribution-empty"><h1>Distribution indisponible</h1><p>Aucun menu ou groupe actif.</p></section>{% elseif selection %}
<a class="distribution-back" href="{{ path('app_sortie_consommation',{jeton:sejour.jetonDistributionPublique}) }}">← Modifier la saisie</a><div class="distribution-title"><h1>Vérifiez la distribution</h1></div><section class="distribution-summary"><dl><div><dt>Groupe</dt><dd>{{ selection.groupe.nom }}</dd></div><div><dt>Date</dt><dd>{{ selection.menu.dateMenu ? selection.menu.dateMenu|date('d/m/Y') : 'Aujourd’hui' }}</dd></div><div><dt>Repas</dt><dd>{{ selection.menu.libelle }}</dd></div></dl><h2>Quantités distribuées</h2><div class="summary-lines">{% for ligne in selection.vue.lignes %}<div><strong>{{ ligne.denree.nom }}</strong><span>{{ selection.quantites[ligne.denree.id ~ '']|number_format(3,',',' ')|replace({',000':''}) }} {{ ligne.unite.symbole }}</span></div>{% endfor %}</div></section>
<form method="post" class="confirmation-form" data-turbo="false" data-action="submit->distribution#stampBrowserTime"><input type="hidden" name="_token" value="{{ csrf_token('sortie_consommation') }}"><input type="hidden" name="action" value="confirmer"><input type="hidden" name="groupe" value="{{ selection.groupe.id }}"><input type="hidden" name="menu" value="{{ selection.menu.id }}"><input type="hidden" name="date_navigateur" data-browser-datetime><input type="hidden" name="heure_navigateur" data-browser-time><input type="hidden" name="decalage_utc" data-browser-offset>{% for id,q in selection.quantites %}<input type="hidden" name="quantites[{{ id }}]" value="{{ q }}">{% endfor %}<button class="distribution-button">Confirmer la distribution</button></form>
{% else %}<div class="distribution-title"><h1>Distribution</h1><p>Saisissez les denrées prises par votre groupe</p></div>{% if erreurs %}<div class="distribution-errors">{% for e in erreurs %}<p>{{ e }}</p>{% endfor %}</div>{% endif %}<form method="post" novalidate data-turbo="false" data-action="submit->distribution#stampBrowserTime"><input type="hidden" name="_token" value="{{ csrf_token('sortie_consommation') }}"><input type="hidden" name="date_navigateur" data-browser-datetime><input type="hidden" name="heure_navigateur" data-browser-time><input type="hidden" name="decalage_utc" data-browser-offset><div class="distribution-selectors"><label>Groupe<select name="groupe" required data-distribution-target="group" data-action="change->distribution#rememberGroup"><option value="">Sélectionner…</option>{% for g in groupes %}<option value="{{ g.id }}"{{ groupe_soumis==g.id~''?' selected':'' }}>{{ g.nom }}</option>{% endfor %}</select></label>{% set dates=[] %}<label>Date<select data-distribution-target="date" data-action="change->distribution#refreshMeals" data-selected="{{ date_soumise }}">{% for m in menus %}{% set d=m.dateMenu ? m.dateMenu|date('Y-m-d') : 'special' %}{% if d not in dates %}<option value="{{ d }}">{{ d=='special'?'Repas généraux':m.dateMenu|date('d/m/Y') }}</option>{% set dates=dates|merge([d]) %}{% endif %}{% endfor %}</select></label><label>Repas<select name="menu" required data-distribution-target="menu" data-action="change->distribution#showMenu" data-selected="{{ menu_soumis }}"><option value="">Sélectionner…</option>{% for m in menus %}<option value="{{ m.id }}" data-date="{{ m.dateMenu ? m.dateMenu|date('Y-m-d') : 'special' }}">{{ m.libelle }}</option>{% endfor %}</select></label></div>
{% for m in menus %}{% set vue=vues[m.id ~ ''] %}<section class="distribution-menu" data-distribution-target="menuBlock" data-menu-id="{{ m.id }}" hidden><p class="distribution-count"><span>✓</span>{{ vue.lignes|length }} denrée{{ vue.lignes|length>1?'s':'' }} à renseigner</p>{% for ligne in vue.lignes %}<article class="distribution-food"><div class="distribution-food__heading"><h2>{{ ligne.denree.nom }}</h2><span>{{ ligne.unite.nom }}</span></div><h3>Portions indicatives</h3><div class="portion-grid">{% for q in ligne.quantites %}<span class="portion-grid__item"><strong>{{ q.libelle }}</strong>{{ q.quantite|quantite_par_personne }} {{ ligne.unite.symbole }}</span>{% endfor %}</div><label class="total-field">Quantité totale distribuée<div><input name="quantites[{{ ligne.denree.id }}]" value="{{ valeurs[ligne.denree.id ~ '']|default('') }}" inputmode="decimal" required><span>{{ ligne.unite.symbole }}</span></div></label></article>{% endfor %}</section>{% endfor %}<div class="distribution-action"><button class="distribution-button">Vérifier la distribution</button></div></form>{% endif %}</div></main>{% endblock %}
