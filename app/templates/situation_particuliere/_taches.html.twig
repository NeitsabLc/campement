<section class="tasks-section"><header class="todo-heading"><div><h2>To-do</h2><p>Actions liées à cette situation</p></div><span>{{ situation.taches|length }}</span></header>
    {% if situation.taches is empty %}<p class="empty-inline">Aucune tâche pour le moment.</p>{% else %}<div class="task-cards">{% for tache in situation.taches %}<details name="taches-situation" class="task-card task-card--{{ tache.statut|lower }}{{ tache.estEnRetard ? ' task-card--late' : '' }}">
        <summary><i aria-hidden="true"></i><span><strong>{{ tache.libelle }}</strong><small>{% if tache.statut == 'REALISE' %}Réalisée{{ tache.dateRealisation ? ' le ' ~ tache.dateRealisation|date('d/m/Y') : '' }}{% elseif tache.dateEcheance %}Échéance : {{ tache.dateEcheance|date('d/m/Y') }}{% else %}Sans échéance{% endif %}</small></span><b>{{ statuts[tache.statut] }}</b></summary>
        <div class="task-card__editor"><span class="task-origin">{{ tache.origine == 'AUTOMATIQUE' ? 'Automatique' : (tache.origine == 'LIBRE' ? 'Autre tâche' : 'Ajout manuel') }}</span>
        <form method="post" action="{{ path('app_situation_particuliere_tache_modifier', {id: situation.id, tacheId: tache.id}) }}" class="task-edit-form"><input type="hidden" name="_token" value="{{ csrf_token('modifier_tache_' ~ tache.id) }}"><div class="task-edit-grid">
            <label>Statut<select name="statut">{% for code, libelle in statuts %}<option value="{{ code }}"{{ code == tache.statut ? ' selected' : '' }}>{{ libelle }}</option>{% endfor %}</select></label>
            <label>Échéance<input type="date" name="date_echeance" value="{{ tache.dateEcheance ? tache.dateEcheance|date('Y-m-d') : '' }}"{{ tache.origine == 'AUTOMATIQUE' ? ' disabled' : '' }}></label>
            <label>Date de réalisation<input type="date" name="date_realisation" value="{{ tache.dateRealisation ? tache.dateRealisation|date('Y-m-d') : '' }}"></label>
        </div><label>Commentaire<textarea name="commentaire" maxlength="2000" rows="2">{{ tache.commentaire }}</textarea></label><footer><button type="submit">Mettre à jour</button></footer></form>
        {% if tache.peutEtreSupprimee %}<form method="post" action="{{ path('app_situation_particuliere_tache_supprimer', {id: situation.id, tacheId: tache.id}) }}" class="task-delete-form"><input type="hidden" name="_token" value="{{ csrf_token('supprimer_tache_' ~ tache.id) }}"><button class="danger-link" type="submit">Supprimer cette tâche</button></form>{% endif %}
        </div></details>{% endfor %}</div>{% endif %}
    <details class="add-task-form"><summary>＋ Ajouter une tâche</summary><form method="post" action="{{ path('app_situation_particuliere_tache_ajouter', {id: situation.id}) }}" data-controller="situation-task-form"><input type="hidden" name="_token" value="{{ csrf_token('ajouter_tache_situation_' ~ situation.id) }}"><div class="add-task-form__fields">
        <label>Type de tâche<select name="type_predefini" data-situation-task-form-target="type" data-action="change->situation-task-form#refresh"><option value="">Autre tâche</option>{% for code, libelle in types_taches %}<option value="{{ code }}">{{ libelle }}</option>{% endfor %}</select></label>
        <label data-situation-task-form-target="freeLabel">Libellé de la tâche<input name="libelle_libre" maxlength="200" placeholder="Décrivez la tâche" required></label>
        <label>Échéance éventuelle<input type="date" name="date_echeance"></label>
    </div><footer class="add-task-form__actions"><button class="food-primary" type="submit">Ajouter la tâche</button></footer></form></details>
</section>
