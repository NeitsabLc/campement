{% extends 'base.html.twig' %}
{% block title %}{{ donnees.groupe_id ? donnees.nom : 'Ajouter une unité' }} | Campement{% endblock %}
{% block body %}
<main class="food-form-page">
    <nav class="food-breadcrumb"><a href="{{ path('app_groupes') }}">Unités participantes</a><span>/</span><span>{{ donnees.groupe_id ? donnees.nom : 'Ajouter' }}</span></nav>
    <header class="food-form-heading"><div><h1>{{ donnees.groupe_id ? donnees.nom : 'Ajouter une unité participante' }}</h1></div></header>
    {% if erreurs %}<div class="distribution-errors flash" role="alert">{% for erreur in erreurs %}<p>{{ erreur }}</p>{% endfor %}</div>{% endif %}
    <form id="group-form" method="post"><section class="food-form-card"><h2>Informations générales</h2>
            <input type="hidden" name="_token" value="{{ csrf_token('enregistrer_groupe') }}">
            <input type="hidden" name="groupe_id" value="{{ donnees.groupe_id }}">
            <div class="group-form-field"><label for="nom">Nom de l’unité</label><input id="nom" name="nom" maxlength="150" required autocomplete="organization" value="{{ donnees.nom }}"></div>
            <fieldset class="group-type-picker"><legend>Type de l’unité</legend>{% for valeur, libelle in types %}<label class="group-type-option group-type-option--{{ valeur }}"><input type="radio" name="type" value="{{ valeur }}" required{{ donnees.type == valeur ? ' checked' : '' }}><span><strong>{{ libelle }}</strong></span></label>{% endfor %}</fieldset>
            <div class="group-counts"><div class="group-form-field"><label for="effectif_jeune">Effectif jeune</label><input id="effectif_jeune" type="number" name="effectif_jeune" min="0" step="1" required value="{{ donnees.effectif_jeune }}"></div><div class="group-form-field"><label for="effectif_adulte">Effectif adulte</label><input id="effectif_adulte" type="number" name="effectif_adulte" min="0" step="1" required value="{{ donnees.effectif_adulte }}"></div></div>
            <div class="group-presence-dates"><div class="group-form-field"><label for="date_debut_presence">Début de présence</label><input id="date_debut_presence" type="date" name="date_debut_presence" min="{{ sejour.dateDebut|date('Y-m-d') }}" max="{{ sejour.dateFin|date('Y-m-d') }}" required value="{{ donnees.date_debut_presence }}"></div><div class="group-form-field"><label for="date_fin_presence">Fin de présence</label><input id="date_fin_presence" type="date" name="date_fin_presence" min="{{ sejour.dateDebut|date('Y-m-d') }}" max="{{ sejour.dateFin|date('Y-m-d') }}" required value="{{ donnees.date_fin_presence }}"></div></div>
    </section>
    {% if sejour.moduleIntendanceActif %}<section class="food-form-card group-stewardship-card"><h2>Intendance</h2>
        {% if donnees.groupe_id %}<section class="group-meals-section"><h3>Repas de l’unité</h3><p>Classez ici uniquement les repas qui diffèrent du menu normal. Les autres repas utilisent automatiquement le menu standard.</p>
        {% if menus_configuration is empty %}<div class="foods-empty">Aucun repas daté n’est configuré.</div>
        {% else %}<div class="group-meal-categories">
            <section class="group-meal-category"><header><h3>Explo</h3><p>Le menu Explo sera utilisé.</p></header><label>Repas concernés<select name="repas_explo[]" multiple data-controller="searchable-select" data-placeholder="Ajouter des repas" data-search-placeholder="Rechercher un repas…" data-search-label="Rechercher un repas" data-empty-label="Aucun repas trouvé">{% for menu in menus_configuration %}{% set menuId = menu.id ~ '' %}<option value="{{ menuId }}"{{ menuId in choix_repas_par_mode.EXPLO ? ' selected' : '' }}>{{ menu.dateMenu|date('d/m/Y') }} — {{ menu.libelle }}</option>{% endfor %}</select></label></section>
            <section class="group-meal-category group-meal-category--picnic"><header><h3>Pique-nique</h3><p>Associez chaque repas au menu correspondant.</p></header><div class="group-picnic-lists"><label>Pique-nique 1<select name="repas_pique_nique_1[]" multiple data-controller="searchable-select" data-placeholder="Ajouter des repas" data-search-placeholder="Rechercher un repas…" data-search-label="Rechercher un repas" data-empty-label="Aucun repas trouvé">{% for menu in menus_configuration %}{% set menuId = menu.id ~ '' %}<option value="{{ menuId }}"{{ menuId in choix_repas_par_mode.PIQUE_NIQUE_1 ? ' selected' : '' }}>{{ menu.dateMenu|date('d/m/Y') }} — {{ menu.libelle }}</option>{% endfor %}</select></label><label>Pique-nique 2<select name="repas_pique_nique_2[]" multiple data-controller="searchable-select" data-placeholder="Ajouter des repas" data-search-placeholder="Rechercher un repas…" data-search-label="Rechercher un repas" data-empty-label="Aucun repas trouvé">{% for menu in menus_configuration %}{% set menuId = menu.id ~ '' %}<option value="{{ menuId }}"{{ menuId in choix_repas_par_mode.PIQUE_NIQUE_2 ? ' selected' : '' }}>{{ menu.dateMenu|date('d/m/Y') }} — {{ menu.libelle }}</option>{% endfor %}</select></label></div></section>
            <section class="group-meal-category"><header><h3>Repas non pris</h3><p>L’unité sera exclue du calcul pour ces repas.</p></header><label>Repas concernés<select name="repas_non_pris[]" multiple data-controller="searchable-select" data-placeholder="Ajouter des repas" data-search-placeholder="Rechercher un repas…" data-search-label="Rechercher un repas" data-empty-label="Aucun repas trouvé">{% for menu in menus_configuration %}{% set menuId = menu.id ~ '' %}<option value="{{ menuId }}"{{ menuId in choix_repas_par_mode.NON_PRIS ? ' selected' : '' }}>{{ menu.dateMenu|date('d/m/Y') }} — {{ menu.libelle }}</option>{% endfor %}</select></label></section>
        </div>{% endif %}</section>{% else %}<p>Enregistrez d’abord l’unité, puis rouvrez sa fiche pour définir ses repas spéciaux et absences.</p>{% endif %}
        <fieldset class="group-dietary-needs"><legend>Besoins alimentaires</legend><p>Indiquez le nombre total de personnes concernées dans l’unité.</p><div class="group-diet-counts"><div class="group-form-field"><label for="nombre_vegetariens">Végétarien</label><input id="nombre_vegetariens" type="number" name="nombre_vegetariens" min="0" step="1" required value="{{ donnees.nombre_vegetariens }}"></div><div class="group-form-field"><label for="nombre_sans_gluten">Sans gluten</label><input id="nombre_sans_gluten" type="number" name="nombre_sans_gluten" min="0" step="1" required value="{{ donnees.nombre_sans_gluten }}"></div><div class="group-form-field"><label for="nombre_sans_lactose">Sans lactose</label><input id="nombre_sans_lactose" type="number" name="nombre_sans_lactose" min="0" step="1" required value="{{ donnees.nombre_sans_lactose }}"></div></div></fieldset>
    </section>{% endif %}
    <div class="food-form-actions"><a class="food-secondary" href="{{ path('app_groupes') }}">Annuler</a><button class="food-primary" type="submit">Enregistrer l’unité</button></div></form>
</main>
{% endblock %}
