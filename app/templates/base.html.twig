<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Campement{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}?v=20260727-14">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="{% block body_class %}{{ app.user ? 'app-shell' : 'auth-shell' }}{% endblock %}">
        {% set afficher_navigation = app.user and app.current_route != 'app_sortie_consommation' %}
        {% if afficher_navigation %}
            <button class="mobile-nav-toggle" type="button" data-sidebar-toggle aria-label="Ouvrir le menu">☰</button>
            <aside class="sidebar" data-sidebar>
                <div class="sidebar__brand"><img src="{{ asset('images/logo-sgdf-vertical.png') }}" alt="Scouts et Guides de France"><span>Campement</span><button type="button" data-sidebar-collapse aria-label="Replier le menu">‹</button></div>
                <nav class="sidebar__nav" aria-label="Navigation principale">
                    <a class="sidebar__link" href="{{ path('app_tableau_de_bord') }}"{{ app.current_route == 'app_tableau_de_bord' ? ' aria-current="page"' : '' }}><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m3 11 9-8 9 8"/><path d="M5 10v11h14V10M9 21v-7h6v7"/></svg></span><span class="sidebar__text">Accueil</span></a>
                    {% if sejour_actif %}<div class="sidebar__stay"><span class="sidebar__icon">▣</span><span class="sidebar__text"><small>Séjour actif</small><strong>{{ sejour_actif.nom }}</strong><small>{{ sejour_actif.dateDebut|date('d/m/Y') }}–{{ sejour_actif.dateFin|date('d/m/Y') }}</small></span></div>{% endif %}
                    {% if is_granted('ROLE_GROUPE') and app.user.groupe %}<a class="sidebar__link" href="{{ path('app_sortie_consommation', {jeton: app.user.groupe.sejour.jetonDistributionPublique}) }}"><span class="sidebar__icon">⇥</span><span class="sidebar__text">Distribution</span></a>{% endif %}
                    {% if is_granted('ROLE_GESTIONNAIRE') and sejour_actif %}<a class="sidebar__link" href="{{ path('app_groupes') }}"{{ app.current_route starts with 'app_groupe' ? ' aria-current="page"' : '' }}><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span><span class="sidebar__text">Unités participantes</span></a>{% endif %}
                    {% if is_granted('ROLE_GESTIONNAIRE') and sejour_actif and sejour_actif.moduleIntendanceActif %}<details class="sidebar__section" open><summary><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 2v7a3 3 0 0 0 3 3V2M6 2v20M21 15V2c-3 2-4 5-4 8v5h4Zm0 0v7"/></svg></span><span class="sidebar__text">Intendance</span></summary><div><a href="{{ path('app_fournisseurs') }}">Fournisseurs</a><a href="{{ path('app_denrees') }}">Denrées</a><a href="{{ path('app_mouvements_stock') }}">Mouvements de stock</a><a href="{{ path('app_recettes') }}">Recettes</a><a href="{{ path('app_menus') }}">Menus</a><a href="{{ path('app_distribution') }}">Distribution</a></div></details>{% endif %}
                    {% if is_granted('ROLE_GESTIONNAIRE') %}<a class="sidebar__link" href="{{ path('app_utilisateurs') }}"><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/></svg></span><span class="sidebar__text">Utilisateurs</span></a>
                    <a class="sidebar__link" href="{{ path('app_sejours') }}"><span class="sidebar__icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m3 20 9-16 9 16H3Z"/><path d="m12 4 3 16M12 4 9 20M9 20l3-5 3 5"/></svg></span><span class="sidebar__text">Gestion des séjours</span></a>{% endif %}
                </nav>
                <div class="sidebar__user user-summary"><span class="sidebar__avatar">{{ app.user.prenom|first }}{{ app.user.nom|first }}</span><span class="sidebar__text"><strong>{{ app.user.prenom }} {{ app.user.nom }}</strong><small>{{ is_granted('ROLE_ADMIN') ? 'Administrateur' : (is_granted('ROLE_GROUPE') ? 'Unité participante' : 'Gestionnaire') }}</small><span class="visually-hidden">{{ app.user.role }}</span></span></div>
                <form class="sidebar__logout-form" method="post" action="{{ path('app_deconnexion') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button class="sidebar__logout" type="submit"><span class="sidebar__icon">↪</span><span class="sidebar__text">Se déconnecter</span></button>
                </form>
            </aside><div class="sidebar-backdrop" data-sidebar-toggle></div>
        {% endif %}

        <div{% if afficher_navigation %} class="page-content"{% endif %}>
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
