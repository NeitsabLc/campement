{% extends 'base.html.twig' %}
{% macro adders(recettes, catalogue, categorie) %}<div class="menu-adders"><div class="menu-adder"><label>Ajouter via une recette<select data-controller="searchable-select" data-search-placeholder="Rechercher une recette…" data-search-label="Rechercher une recette" data-empty-label="Aucune recette trouvée" data-recipe-picker><option value="">Sélectionner…</option>{% for r in recettes %}{% if not categorie or r.categorie == categorie %}<option value="{{ r.id }}">{{ r.nom }}</option>{% endif %}{% endfor %}</select></label><button type="button" class="button button--secondary" data-action="menu-editor#addRecipe">Ajouter</button></div><div class="menu-adder"><label>Ajouter une denrée<select data-controller="searchable-select" data-food-picker><option value="">Sélectionner…</option>{% for id,d in catalogue %}<option value="{{ id }}">{{ d.nom }}</option>{% endfor %}</select></label><button type="button" class="button button--secondary" data-action="menu-editor#addFood">Ajouter</button></div></div>{% endmacro %}
{% macro table_header(publicsCibles) %}<div class="food-row food-row--header"><span>Denrée</span><span>Conditionnement</span>{% for p in publicsCibles %}<span>{{ p.publicCible.libelle }}</span>{% endfor %}<span></span></div>{% endmacro %}
{% macro food_line(ligne, publicsCibles, categorie, recetteId, instanceId) %}<div class="food-row" data-line><strong>{{ ligne.denree.nom }}</strong><input type="hidden" data-field="denree" value="{{ ligne.denree.id }}"><input type="hidden" data-field="categorie" value="{{ categorie }}"><input type="hidden" data-field="recette" value="{{ recetteId|default('') }}"><input type="hidden" data-field="recette_instance" value="{{ instanceId|default('') }}"><select data-field="conditionnement" data-selected="{{ ligne.conditionnement.id }}"></select>{% for p in publicsCibles %}{% set v='0' %}{% for q in ligne.quantites %}{% if q.sejourPublicCible == p %}{% set v=q.quantiteIndividuelle %}{% endif %}{% endfor %}<input data-public="{{ p.id }}" value="{{ v|replace({'.':','}) }}" required>{% endfor %}<button type="button" class="delete-food" data-action="menu-editor#remove" aria-label="Supprimer {{ ligne.denree.nom }}" title="Supprimer"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div>{% endmacro %}
{% macro composition(composition, publicsCibles, categorie) %}
    <div data-recipe-groups>{% for groupe in composition.recettes|default([]) %}
        <section class="menu-recipe" data-recipe-group data-recipe="{{ groupe.id }}" data-recipe-instance="{{ groupe.instance }}">
            <header><h4>{{ groupe.nom }}</h4><div><button type="button" class="action-icon-button" data-action="menu-editor#resetRecipe" title="Rafraîchir la recette" aria-label="Rafraîchir la recette"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button><button type="button" class="action-icon-button action-icon-button--danger" data-action="menu-editor#removeRecipe" title="Supprimer la recette" aria-label="Supprimer la recette"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div></header>
            <div class="food-table">{{ _self.table_header(publicsCibles) }}<div data-recipe-rows>{% for ligne in groupe.lignes %}{{ _self.food_line(ligne, publicsCibles, categorie, groupe.id, groupe.instance) }}{% endfor %}</div></div>
        </section>
    {% endfor %}</div>
    <section class="menu-extras"><h4>Denrées supplémentaires</h4><div class="food-table">{{ _self.table_header(publicsCibles) }}<div data-extra-rows>{% for ligne in composition.supplementaires|default([]) %}{{ _self.food_line(ligne, publicsCibles, categorie, '', '') }}{% endfor %}</div></div></section>
{% endmacro %}
{% block title %}Gestion des menus | Campement{% endblock %}
{% block body %}
<main class="menus-page{{ avec_categories|default(false) ? ' menus-page--categorized' : '' }}" data-controller="menu-editor" data-public-count="{{ publicsCibles|default([])|length }}">
    <header class="menus-heading"><h1>Gestion des menus</h1>{% if sejour %}<span class="stay-badge"><strong>{{ sejour.nom }}</strong></span>{% endif %}</header>
    {% for m in app.flashes('success') %}<div class="flash flash--success">{{ m }}</div>{% endfor %}
    {% for m in app.flashes('error') %}<div class="flash flash--error">{{ m }}</div>{% endfor %}
    {% if not sejour %}<section class="empty-state"><h2>Aucun séjour actif</h2></section>
    {% elseif repas is empty %}<section class="empty-state"><h2>Aucun repas disponible</h2></section>
    {% else %}
    <div class="menus-layout">
        <aside class="meal-calendar" data-turbo-prefetch="false">
            <section class="meal-day"><h2>Repas généraux</h2><div class="meal-day__items">
                {% for code, libelle in specials %}{% set renseigne = menus_existants['special|' ~ code]|default(false) %}
                    <a class="meal-slot{{ special == code ? ' meal-slot--active' : '' }}{{ renseigne ? ' meal-slot--complete' : '' }}" href="{{ path('app_menus', {special: code}) }}">
                        <span class="meal-slot__status" aria-hidden="true">{{ renseigne ? '✓' : '' }}</span><strong>{{ libelle }}</strong><span class="meal-slot__arrow" aria-hidden="true">›</span>
                    </a>
                {% endfor %}
            </div></section>
            {% for jour in jours %}<section class="meal-day"><h2>{{ jour|date('d/m/Y') }}</h2><div class="meal-day__items">
                {% for r in repas %}{% set renseigne = menus_existants[jour|date('Y-m-d') ~ '|' ~ r.id]|default(false) %}
                    <a class="meal-slot{{ not special and jour == date_selectionnee and r == repas_selectionne ? ' meal-slot--active' : '' }}{{ renseigne ? ' meal-slot--complete' : '' }}" href="{{ path('app_menus', {date: jour|date('Y-m-d'), repas: r.id}) }}">
                        <span class="meal-slot__status" aria-hidden="true">{{ renseigne ? '✓' : '' }}</span><strong>{{ r.typeRepas.libelle }}</strong><span class="meal-slot__arrow" aria-hidden="true">›</span>
                    </a>
                {% endfor %}
            </div></section>{% endfor %}
        </aside>
        <section class="meal-editor">
            <h2>{{ special ? specials[special] : repas_selectionne.typeRepas.libelle ~ ' · ' ~ date_selectionnee|date('d/m/Y') }}</h2>
            <form method="post"><input type="hidden" name="_token" value="{{ csrf_token('enregistrer_menu') }}">
                {% if avec_categories %}
                    <div class="menu-categories">{% for code, libelle in {'ENTREE':'Entrée','PLAT':'Plat','FROMAGE':'Fromage','DESSERT':'Dessert'} %}
                        <section class="menu-category" data-menu-block data-category="{{ code }}">
                            <h3>{{ libelle }}</h3>{{ _self.adders(recettes, catalogue, code) }}
                            {{ _self.composition(composition_menu[code]|default({}), publicsCibles, code) }}
                        </section>
                    {% endfor %}</div>
                {% else %}
                    <section class="menu-simple-list" data-menu-block data-category="">
                        {{ _self.adders(recettes, catalogue, null) }}
                        {{ _self.composition(composition_menu['']|default({}), publicsCibles, '') }}
                    </section>
                {% endif %}
                <div class="meal-editor__actions"><button class="save-meal-button">Enregistrer ce repas</button></div>
            </form>
        </section>
    </div>
    <template data-menu-editor-target="recipeTemplate"><section class="menu-recipe" data-recipe-group><header><h4 data-recipe-name></h4><div><button type="button" class="action-icon-button" data-action="menu-editor#resetRecipe" title="Rafraîchir la recette" aria-label="Rafraîchir la recette"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button><button type="button" class="action-icon-button action-icon-button--danger" data-action="menu-editor#removeRecipe" title="Supprimer la recette" aria-label="Supprimer la recette"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div></header><div class="food-table">{{ _self.table_header(publicsCibles) }}<div data-recipe-rows></div></div></section></template>
    <template data-menu-editor-target="template"><div class="food-row" data-line><strong data-name></strong><input type="hidden" data-field="denree"><input type="hidden" data-field="categorie"><input type="hidden" data-field="recette"><input type="hidden" data-field="recette_instance"><select data-field="conditionnement"></select>{% for p in publicsCibles %}<input data-public="{{ p.id }}" required value="0">{% endfor %}<button type="button" class="delete-food" data-action="menu-editor#remove" aria-label="Supprimer la denrée" title="Supprimer"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div></template>
    <script nonce="{{ app.request.attributes.get('csp_nonce') }}" type="application/json" data-menu-editor-target="catalog">{{ catalogue|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script><script nonce="{{ app.request.attributes.get('csp_nonce') }}" type="application/json" data-menu-editor-target="recipes">{{ recettes_json|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
    {% endif %}
</main>
{% endblock %}
