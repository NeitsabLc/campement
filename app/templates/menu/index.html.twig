{% extends 'base.html.twig' %}
{% macro adders(recettes, catalogue) %}<div class="menu-adders"><label>Ajouter via une recette<select data-recipe-picker><option value="">Sélectionner…</option>{% for r in recettes %}<option value="{{ r.id }}">{{ r.nom }}</option>{% endfor %}</select></label><button type="button" class="button button--secondary" data-action="menu-editor#addRecipe">Ajouter la recette</button><label>Ajouter une denrée<select data-food-picker><option value="">Sélectionner…</option>{% for id,d in catalogue %}<option value="{{ id }}">{{ d.nom }}</option>{% endfor %}</select></label><button type="button" class="button button--secondary" data-action="menu-editor#addFood">Ajouter</button></div>{% endmacro %}
{% macro table_header(publicsCibles) %}<div class="food-row food-row--header"><span>Denrée</span><span>Conditionnement</span>{% for p in publicsCibles %}<span>{{ p.publicCible.libelle }}</span>{% endfor %}<span></span></div>{% endmacro %}
{% macro food_line(ligne, publicsCibles, categorie) %}<div class="food-row" data-line><strong>{{ ligne.denree.nom }}</strong><input type="hidden" data-field="denree" value="{{ ligne.denree.id }}"><input type="hidden" data-field="categorie" value="{{ categorie }}"><select data-field="conditionnement" data-selected="{{ ligne.conditionnement.id }}"></select>{% for p in publicsCibles %}{% set v='0' %}{% for q in ligne.quantites %}{% if q.sejourPublicCible == p %}{% set v=q.quantiteIndividuelle %}{% endif %}{% endfor %}<input data-public="{{ p.id }}" value="{{ v|replace({'.':','}) }}" required>{% endfor %}<button type="button" class="delete-food" data-action="menu-editor#remove" aria-label="Supprimer {{ ligne.denree.nom }}" title="Supprimer"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div>{% endmacro %}
{% block title %}Gestion des menus | Campement{% endblock %}
{% block body %}
<main class="menus-page{{ avec_categories|default(false) ? ' menus-page--categorized' : '' }}" data-controller="menu-editor" style="--public-count:{{ publicsCibles|default([])|length }}">
    <header class="menus-heading"><h1>Gestion des menus</h1>{% if sejour %}<span class="stay-badge"><strong>{{ sejour.nom }}</strong></span>{% endif %}</header>
    {% for m in app.flashes('success') %}<div class="flash flash--success">{{ m }}</div>{% endfor %}
    {% for m in app.flashes('error') %}<div class="flash flash--error">{{ m }}</div>{% endfor %}
    {% if not sejour %}<section class="empty-state"><h2>Aucun séjour actif</h2></section>
    {% elseif repas is empty %}<section class="empty-state"><h2>Aucun repas disponible</h2></section>
    {% else %}
    <div class="menus-layout">
        <aside class="meal-calendar">
            <section class="meal-day"><h2>Repas généraux</h2><div class="meal-day__items">
                {% for code, libelle in specials %}{% set renseigne = menus_existants['special|' ~ code]|default(false) %}
                    <a class="meal-slot{{ special == code ? ' meal-slot--active' : '' }}{{ renseigne ? ' meal-slot--complete' : '' }}" href="{{ path('app_menus', {special: code}) }}">
                        <span class="meal-slot__status" aria-hidden="true">{{ renseigne ? '✓' : '' }}</span><strong>{{ libelle }}</strong><span class="meal-slot__arrow" aria-hidden="true">›</span>
                    </a>
                {% endfor %}
            </div></section>
            {% for jour in jours %}<section class="meal-day"><h2>{{ jour|date('d/m/Y') }}</h2><div class="meal-day__items">
                {% for r in repas %}{% set renseigne = menus_existants[jour|date('Y-m-d') ~ '|' ~ r.id]|default(false) %}
                    <a class="meal-slot{{ not special and jour == date_selectionnee and r == repas_selectionne ? ' meal-slot--active' : '' }}{{ renseigne ? ' meal-slot--complete' : '' }}" href="{{ path('app_menus', {date: jour|date('Y-m-d'), repas: r.id}) }}">
                        <span class="meal-slot__status" aria-hidden="true">{{ renseigne ? '✓' : '' }}</span><strong>{{ r.typeRepas.libelle }}</strong><span class="meal-slot__arrow" aria-hidden="true">›</span>
                    </a>
                {% endfor %}
            </div></section>{% endfor %}
        </aside>
        <section class="meal-editor">
            <h2>{{ special ? specials[special] : repas_selectionne.typeRepas.libelle ~ ' · ' ~ date_selectionnee|date('d/m/Y') }}</h2>
            <form method="post"><input type="hidden" name="_token" value="{{ csrf_token('enregistrer_menu') }}">
                {% if avec_categories %}
                    <div class="menu-categories">{% for code, libelle in {'ENTREE':'Entrée','PLAT':'Plat','FROMAGE':'Fromage','DESSERT':'Dessert'} %}
                        <section class="menu-category" data-menu-block data-category="{{ code }}">
                            <h3>{{ libelle }}</h3>{{ _self.adders(recettes, catalogue) }}
                            <div class="food-table">{{ _self.table_header(publicsCibles) }}<div data-menu-rows>{% if menu %}{% for ligne in menu.denrees %}{% if (ligne.categorie|default('PLAT')) == code %}{{ _self.food_line(ligne, publicsCibles, code) }}{% endif %}{% endfor %}{% endif %}</div></div>
                        </section>
                    {% endfor %}</div>
                {% else %}
                    <section class="menu-simple-list" data-menu-block data-category="">
                        {{ _self.adders(recettes, catalogue) }}
                        <div class="food-table">{{ _self.table_header(publicsCibles) }}<div data-menu-rows>{% if menu %}{% for ligne in menu.denrees %}{{ _self.food_line(ligne, publicsCibles, '') }}{% endfor %}{% endif %}</div></div>
                    </section>
                {% endif %}
                <div class="meal-editor__actions"><button class="save-meal-button">Enregistrer ce repas</button></div>
            </form>
        </section>
    </div>
    <template data-menu-editor-target="template"><div class="food-row" data-line><strong data-name></strong><input type="hidden" data-field="denree"><input type="hidden" data-field="categorie"><select data-field="conditionnement"></select>{% for p in publicsCibles %}<input data-public="{{ p.id }}" required value="0">{% endfor %}<button type="button" class="delete-food" data-action="menu-editor#remove" aria-label="Supprimer la denrée" title="Supprimer"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div></template>
    <script type="application/json" data-menu-editor-target="catalog">{{ catalogue|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script><script type="application/json" data-menu-editor-target="recipes">{{ recettes_json|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
    {% endif %}
</main>
{% endblock %}
