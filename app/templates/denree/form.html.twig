{% extends 'base.html.twig' %}
{% block title %}{{ creation ? 'Ajouter' : 'Modifier' }} une denrée | Campement{% endblock %}
{% block body %}
<main class="food-form-page" data-controller="food-form" data-food-form-allow-empty-value="{{ references_archivees > 0 ? 'true' : 'false' }}">
 <div class="food-breadcrumb"><a href="{{ path('app_denrees') }}">Denrées</a><span>›</span><span>{{ creation ? 'Ajouter' : 'Modifier' }}</span></div>
 <header class="food-form-heading"><div><h1>{{ creation ? 'Ajouter une denrée' : 'Modifier la denrée' }}</h1></div><div><a href="{{ path('app_denrees') }}" class="food-secondary">Annuler</a><button class="food-primary" type="submit" form="food-form">Enregistrer</button></div></header>
 {% if erreurs %}<div class="flash flash--error" role="alert">{% for erreur in erreurs %}<p>{{ erreur }}</p>{% endfor %}</div>{% endif %}
 <form id="food-form" method="post"><input type="hidden" name="_token" value="{{ csrf_token('enregistrer_denree') }}">
  <section class="food-form-card"><h2>Informations générales</h2><div class="food-general-grid"><label>Nom de la denrée <b>*</b><input name="nom" maxlength="150" required value="{{ donnees.nom }}"></label><label>Unité de référence <b>*</b><select name="unite" required data-food-form-target="referenceUnit" data-action="change->food-form#refresh">{% for unite in unites %}<option value="{{ unite.id }}" data-symbol="{{ unite.symbole }}"{{ donnees.unite == unite.id ? ' selected' : '' }}>{{ unite.symbole }} — {{ unite.nom }}</option>{% endfor %}</select><small>L’unité de référence termine chaque chaîne de conditionnement.</small></label></div></section>
  <section class="food-form-card suppliers-section"><header><div><h2>Fournisseurs</h2><p>Ajoutez au moins un fournisseur et son conditionnement.{% if references_archivees > 0 %} {{ references_archivees }} affectation{{ references_archivees > 1 ? 's' : '' }} à un fournisseur inactif reste{{ references_archivees > 1 ? 'nt' : '' }} conservée{{ references_archivees > 1 ? 's' : '' }} et masquée{{ references_archivees > 1 ? 's' : '' }}.{% endif %}</p></div><button class="food-secondary" type="button" data-action="food-form#addSupplier">＋ Ajouter un fournisseur</button></header><div data-food-form-target="suppliers"></div></section>
  <div class="food-form-actions"><a href="{{ path('app_denrees') }}" class="food-secondary">Annuler</a><button class="food-primary" type="submit">Enregistrer la denrée</button></div>
 </form>
 <template data-food-form-target="supplierTemplate"><article class="supplier-card" data-supplier><header><strong data-supplier-title>Fournisseur</strong><button type="button" data-action="food-form#removeSupplier">Retirer</button></header><input type="hidden" data-field="id"><div class="supplier-grid"><label>Fournisseur <b>*</b><select data-field="fournisseur" required data-action="change->food-form#refresh"><option value="">Sélectionner…</option>{% for fournisseur in fournisseurs %}<option value="{{ fournisseur.id }}">{{ fournisseur.nom }}</option>{% endfor %}</select></label><label>Référence fournisseur <b>*</b><input data-field="reference" maxlength="100" required></label></div><div class="packaging"><h3>Conditionnement</h3><p>Décrivez les niveaux du plus grand au plus petit.</p><div data-levels></div><button class="add-level" type="button" data-action="food-form#addLevel">＋ Ajouter un niveau</button><div class="packaging-summary" data-summary></div></div></article></template>
 <template data-food-form-target="levelTemplate"><div class="packaging-row" data-level><span class="level-number"></span><input type="hidden" data-level-field="id"><label><span>Conditionnement</span><input data-level-field="libelle" placeholder="Palette" maxlength="50" required data-action="input->food-form#refresh"></label><span class="contains">contient</span><label><span>Quantité</span><input type="number" min="0.001" step="0.001" data-level-field="quantite" required data-action="input->food-form#refresh"></label><span class="next-level" data-next-level></span><button type="button" class="remove-level" aria-label="Supprimer ce niveau" title="Supprimer" data-action="food-form#removeLevel"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="visually-hidden">Supprimer</span></button></div></template>
 <script type="application/json" data-food-form-target="initial">{{ donnees.fournisseurs|json_encode|raw }}</script>
</main>
{% endblock %}
