{% extends 'base.html.twig' %}
{% block title %}Gestion des denrées | Campement{% endblock %}
{% block body %}
<main class="foods-page"><header class="foods-heading"><div><h1>Gestion des denrées</h1></div><a class="food-primary" href="{{ path('app_denree_ajouter') }}"><span>＋</span> Ajouter une denrée</a></header>
{% for message in app.flashes('success') %}<div class="flash flash--success" role="status">{{ message }}</div>{% endfor %}
{% if not sejour %}<section class="empty-state"><h2>Aucun séjour actif</h2></section>{% else %}
<section class="foods-card" data-controller="food-catalog"><div class="foods-tools"><label class="food-search"><span aria-hidden="true">⌕</span><span class="visually-hidden">Rechercher</span><input type="search" placeholder="Rechercher une denrée…" data-food-catalog-target="search" data-action="input->food-catalog#filter"></label><nav class="food-tabs"><a href="{{ path('app_denrees') }}"{{ actives ? ' aria-current="page"' : '' }}>Actives</a><a href="{{ path('app_denrees',{desactivees:1}) }}"{{ not actives ? ' aria-current="page"' : '' }}>Désactivées</a></nav></div>
<div class="foods-table"><div class="foods-row foods-row--head"><span>Denrée</span><span>Stock actuel</span><span>Statut</span><span>Actions</span></div><div data-food-catalog-target="rows">
{% for ligne in denrees %}{% set d=ligne.denree %}{% set sous_seuil=d.stockMin is not null and ligne.stockInventaire < d.stockMin %}<div class="foods-row" data-food-catalog-target="row" data-name="{{ d.nom|lower }}"><strong>{{ d.nom }}</strong><span class="stock-cell"><span class="stock-value">{{ ligne.stockInventaire|number_format(0,',',' ') }} {{ d.uniteInventaire.symbole }}</span>{% if sous_seuil %}<span class="stock-alert">Stock sous le seuil · min. {{ d.stockMin|number_format(3,',',' ')|replace({',000':''}) }} {{ d.uniteInventaire.symbole }}</span>{% endif %}</span><span><span class="status-pill status-pill--{{ d.actif ? 'active' : 'inactive' }}">{{ d.actif ? 'Active' : 'Désactivée' }}</span></span><span class="food-actions">
<a class="action-icon-button" href="{{ path('app_denree_modifier',{id:d.id}) }}" aria-label="Modifier {{ d.nom }}" title="Modifier"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 20h4l11-11-4-4L4 16v4Zm13.5-16.5 3 3a1.4 1.4 0 0 1 0 2L19 10l-5-5 1.5-1.5a1.4 1.4 0 0 1 2 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span class="visually-hidden">Modifier</span></a>
<form method="post" action="{{ path('app_denree_statut',{id:d.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('statut_denree_'~d.id) }}">{% if d.actif %}<button type="submit" class="action-icon-button action-icon-button--danger" aria-label="Désactiver {{ d.nom }}" title="Désactiver"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="visually-hidden">Désactiver</span></button>{% else %}<button type="submit" class="reactivate-food">Réactiver</button>{% endif %}</form></span></div>
{% else %}<div class="foods-empty">Aucune denrée.</div>{% endfor %}</div></div><p class="foods-note">ⓘ Le stock est affiché dans l’unité d’inventaire, avec arrondi à l’entier supérieur.</p></section>{% endif %}</main>
{% endblock %}
