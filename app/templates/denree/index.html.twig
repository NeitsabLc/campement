{% extends 'base.html.twig' %}
{% block title %}Denrées | Campement{% endblock %}
{% block body %}
<main class="foods-page entity-list-page"><header class="foods-heading entity-list-heading"><div><h1>Denrées</h1></div><a class="food-primary food-add-button" href="{{ path('app_denree_ajouter') }}" aria-label="Ajouter une denrée"><span aria-hidden="true">＋</span><span class="food-add-button__label">Ajouter une denrée</span></a></header>
{% for message in app.flashes('success') %}<div class="flash flash--success" role="status">{{ message }}</div>{% endfor %}
{% if not sejour %}<section class="empty-state"><h2>Aucun séjour actif</h2></section>{% else %}
<section class="foods-card" data-controller="food-catalog"><div class="foods-tools"><label class="food-search"><span aria-hidden="true">⌕</span><span class="visually-hidden">Rechercher</span><input type="search" placeholder="Rechercher une denrée…" data-food-catalog-target="search" data-action="input->food-catalog#filter"></label><nav class="food-tabs"><a href="{{ path('app_denrees',{tri:tri,ordre:ordre}) }}"{{ actives ? ' aria-current="page"' : '' }}>Actives</a><a class="food-tabs__inactive" href="{{ path('app_denrees',{desactivees:1,tri:tri,ordre:ordre}) }}"{{ not actives ? ' aria-current="page"' : '' }}>Désactivées</a></nav></div>
<div class="foods-table"><div class="foods-row foods-row--head">
<span><a class="foods-sort-link" href="{{ path('app_denrees', (actives ? {} : {desactivees:1})|merge({tri:'nom',ordre:tri == 'nom' and ordre == 'asc' ? 'desc' : 'asc'})) }}" aria-label="Trier les libellés par ordre {{ tri == 'nom' and ordre == 'asc' ? 'alphabétique inverse' : 'alphabétique' }}">Libellé <span class="foods-sort-indicator" aria-hidden="true">{{ tri == 'nom' ? (ordre == 'asc' ? '↑' : '↓') : '↕' }}</span></a></span>
<span><a class="foods-sort-link" href="{{ path('app_denrees', (actives ? {} : {desactivees:1})|merge({tri:'stock',ordre:tri == 'stock' and ordre == 'asc' ? 'desc' : 'asc'})) }}" aria-label="Trier les stocks du {{ tri == 'stock' and ordre == 'asc' ? 'plus grand au plus petit' : 'plus petit au plus grand' }}">Stock <span class="foods-sort-indicator" aria-hidden="true">{{ tri == 'stock' ? (ordre == 'asc' ? '↑' : '↓') : '↕' }}</span></a></span>
<span>Statut</span><span>Actions</span></div><div data-food-catalog-target="rows">
{% for ligne in denrees %}{% set d=ligne.denree %}{% set sous_seuil=d.stockMin is not null and ligne.stockInventaire < d.stockMin %}<div class="foods-swipe-row" data-controller="swipe-actions" data-food-catalog-target="row" data-name="{{ d.nom|lower }}" data-swipe-actions-url-value="{{ path('app_denree_modifier',{id:d.id}) }}">
<form class="foods-swipe-action{{ d.actif ? '' : ' foods-swipe-action--reactivate' }}" method="post" action="{{ path('app_denree_statut',{id:d.id}) }}" data-swipe-actions-target="action"><input type="hidden" name="_token" value="{{ csrf_token('statut_denree_'~d.id) }}"><button type="submit" aria-label="{{ d.actif ? 'Désactiver' : 'Réactiver' }} {{ d.nom }}">{{ d.actif ? 'Désactiver' : 'Réactiver' }}</button></form>
<a class="foods-swipe-history" href="{{ path('app_denree_mouvements',{id:d.id}) }}" data-swipe-actions-target="startAction">Mouvements</a>
<div class="foods-row clickable-row" role="link" tabindex="0" data-swipe-actions-target="surface" data-action="pointerdown->swipe-actions#start pointermove->swipe-actions#move pointerup->swipe-actions#end pointercancel->swipe-actions#cancel click->swipe-actions#activate keydown->swipe-actions#activate"><strong>{{ d.nom }}</strong><span class="stock-cell"><span class="stock-value">{{ ligne.stockInventaire|number_format(0,',',' ') }} {{ d.uniteInventaire.symbole }}</span>{% if sous_seuil %}<span class="stock-alert">Stock sous le seuil · min. {{ d.stockMin|number_format(3,',',' ')|replace({',000':''}) }} {{ d.uniteInventaire.symbole }}</span>{% endif %}</span><span><span class="status-pill status-pill--{{ d.actif ? 'active' : 'inactive' }}">{{ d.actif ? 'Active' : 'Désactivée' }}</span></span><span class="food-actions">
<a class="action-icon-button" href="{{ path('app_denree_mouvements',{id:d.id}) }}" aria-label="Voir les mouvements de {{ d.nom }}" title="Mouvements de stock"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 8h14M14 4l4 4-4 4M20 16H6M10 12l-4 4 4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="visually-hidden">Mouvements de stock</span></a>
<a class="action-icon-button" href="{{ path('app_denree_modifier',{id:d.id}) }}" aria-label="Modifier {{ d.nom }}" title="Modifier"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 20h4l11-11-4-4L4 16v4Zm13.5-16.5 3 3a1.4 1.4 0 0 1 0 2L19 10l-5-5 1.5-1.5a1.4 1.4 0 0 1 2 0Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span class="visually-hidden">Modifier</span></a>
<form method="post" action="{{ path('app_denree_statut',{id:d.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('statut_denree_'~d.id) }}">{% if d.actif %}<button type="submit" class="action-icon-button action-icon-button--danger" aria-label="Désactiver {{ d.nom }}" title="Désactiver"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 7h14M9 7V4h6v3m2 0-1 13H8L7 7m3 4v5m4-5v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="visually-hidden">Désactiver</span></button>{% else %}<button type="submit" class="reactivate-food">Réactiver</button>{% endif %}</form></span></div></div>
{% else %}<div class="foods-empty">Aucune denrée.</div>{% endfor %}</div></div><p class="foods-note">ⓘ Le stock est affiché dans l’unité d’inventaire, avec arrondi à l’entier supérieur.</p></section>{% endif %}</main>
{% endblock %}
