{% extends 'base.html.twig' %}

{% block title %}Connexion | Campement{% endblock %}
{% block body_class %}login-shell{% endblock %}

{% block body %}
    <main class="login-page">
        <section class="login-panel" aria-labelledby="connexion-title">
            <div class="login-identity" aria-label="Campement, Gestion des camps accompagnés">
                <span class="login-identity__symbol" aria-hidden="true">CA</span>
                <span>
                    <strong>Campement</strong>
                    <small>Gestion des camps accompagnés</small>
                </span>
                <img class="login-identity__sgdf-logo" src="{{ asset('images/logo-sgdf-horizontal.png') }}" alt="Scouts et Guides de France">
            </div>

            <header class="login-header">
                <p class="login-eyebrow">Gestion des camps accompagnés</p>
                <h1 id="connexion-title">Ravi de vous revoir</h1>
                <p>Connectez-vous pour organiser votre séjour et préparer l’accueil des unités participantes.</p>
            </header>

            {% if erreur %}
                <div class="login-alert login-alert--error" role="alert">Identifiants incorrects.</div>
            {% endif %}
            {% for message in app.flashes('success') %}<div class="login-alert login-alert--success" role="status">{{ message }}</div>{% endfor %}

            <form class="login-form" method="post" action="{{ path('app_connexion') }}">
                <div class="login-field">
                    <label for="email">Adresse e-mail</label>
                    <input
                        id="email"
                        name="_username"
                        type="email"
                        value="{{ derniere_adresse }}"
                        autocomplete="email"
                        required
                        autofocus
                    >
                </div>

                <div class="login-field">
                    <label for="mot-de-passe">Mot de passe</label>
                    <input
                        id="mot-de-passe"
                        name="_password"
                        type="password"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="login-submit" type="submit">Se connecter</button>
            </form>
            <p class="login-note"><a href="{{ path('app_mot_de_passe_oublie') }}">Mot de passe oublié ?</a></p>
        </section>
        <aside class="login-illustration" aria-hidden="true">
            <div class="login-welcome">
                <p class="login-eyebrow login-eyebrow--light">Bienvenue au camp</p>
                <p>« Tout ce qu’il faut pour vivre pleinement l’aventure. »</p>
            </div>
        </aside>
    </main>
{% endblock %}
