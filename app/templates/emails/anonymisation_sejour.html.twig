<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anonymisation du séjour {{ sejour.nom }}</title>
</head>
<body style="margin:0;padding:0;background-color:#f3f6f8;color:#073f61;font-family:Arial,Helvetica,sans-serif;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background-color:#f3f6f8;">
    <tr>
        <td align="center" style="padding:32px 16px;">
            <table role="presentation" width="640" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:640px;background-color:#ffffff;border-collapse:collapse;">
                <tr>
                    <td style="padding:24px 32px;border-bottom:1px solid #dce6eb;">
                        <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                            <tr>
                                <td width="66" height="66" align="center" valign="middle" style="width:66px;height:66px;background-color:#073f61;border-radius:18px 18px 18px 4px;font-size:23px;font-weight:800;color:#ffffff;">CA</td>
                                <td valign="middle" style="padding-left:18px;">
                                    <p style="margin:0 0 4px;font-size:24px;line-height:1.15;font-weight:700;color:#073f61;">Campement</p>
                                    <p style="margin:0;font-size:15px;line-height:1.3;color:#526b7b;">Gestion des camps accompagnés</p>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr>
                    <td style="padding:34px 32px;background-color:#073f61;color:#ffffff;">
                        <p style="margin:0 0 10px;font-size:13px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:#69c3a5;">Information technique</p>
                        <h1 style="margin:0;font-size:30px;line-height:1.2;color:#ffffff;">Anonymisation terminée</h1>
                        <p style="margin:12px 0 0;font-size:17px;line-height:1.5;color:#ffffff;">Le traitement automatique du séjour a été effectué.</p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:32px;">
                        <p style="margin:0 0 22px;font-size:17px;line-height:1.6;color:#073f61;">Bonjour,</p>
                        <p style="margin:0 0 24px;font-size:17px;line-height:1.6;color:#073f61;">Le séjour <strong>« {{ sejour.nom }} »</strong>, terminé le <strong>{{ sejour.dateFin|date('d/m/Y') }}</strong>, a été désactivé et anonymisé conformément à la durée de conservation prévue.</p>

                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:collapse;background-color:#e3f3ed;border-left:6px solid #58b99a;">
                            <tr>
                                <td style="padding:20px 22px;">
                                    <p style="margin:0 0 10px;font-size:16px;font-weight:700;color:#073f61;">Données supprimées définitivement</p>
                                    <p style="margin:0;font-size:15px;line-height:1.7;color:#174f6d;">Participants et documents associés<br>Registre de présence<br>Associations entre personnes et situations particulières</p>
                                </td>
                            </tr>
                        </table>

                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;margin-top:16px;border-collapse:collapse;background-color:#f4f8fa;border-left:6px solid #073f61;">
                            <tr>
                                <td style="padding:20px 22px;">
                                    <p style="margin:0 0 8px;font-size:16px;font-weight:700;color:#073f61;">Données conservées</p>
                                    <p style="margin:0;font-size:15px;line-height:1.7;color:#174f6d;">Données d’intendance et unités participantes.</p>
                                </td>
                            </tr>
                        </table>

                        <p style="margin:26px 0 0;font-size:14px;line-height:1.6;color:#607987;">Aucune action n’est requise de votre part.</p>
                    </td>
                </tr>
                <tr>
                    <td style="padding:20px 32px;background-color:#eef3f5;border-top:1px solid #dce6eb;font-size:12px;line-height:1.6;color:#607987;">
                        Message automatique envoyé par Campement. Merci de ne pas répondre à cet e-mail.
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
