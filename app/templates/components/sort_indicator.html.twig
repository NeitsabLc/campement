<span class="foods-sort-indicator{{ actif ? ' foods-sort-indicator--active' : '' }}" aria-hidden="true">
    {% if not actif %}
        <svg data-sort-state="none" viewBox="0 0 24 24"><path d="M4 7h8M4 12h8M4 17h8M18 5v14M15.5 7.5 18 5l2.5 2.5M15.5 16.5 18 19l2.5-2.5"/></svg>
    {% elseif ordre == 'asc' %}
        <svg data-sort-state="ascending" viewBox="0 0 24 24"><path d="M4 17h9M4 12h6M4 7h3M18 19V5M15 8l3-3 3 3"/></svg>
    {% else %}
        <svg data-sort-state="descending" viewBox="0 0 24 24"><path d="M4 7h9M4 12h6M4 17h3M18 5v14M15 16l3 3 3-3"/></svg>
    {% endif %}
</span>
