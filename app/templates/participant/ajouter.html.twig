{% extends 'base.html.twig' %}
{% set type = donnees.type in ['jeune', 'adulte'] ? donnees.type : 'jeune' %}
{% block title %}Ajouter {{ type == 'jeune' ? 'un jeune' : 'un adulte' }} | Participants | Campement{% endblock %}
{% block body %}
<main class="participant-edit-page food-form-page">
    <nav class="food-breadcrumb"><a href="{{ path('app_participants') }}">Participants</a><span>/</span><span>Ajouter</span></nav>
    <header class="food-form-heading"><div><h1>Ajouter {{ type == 'jeune' ? 'un jeune' : 'un adulte' }}</h1></div></header>
    {% if erreurs %}<div class="distribution-errors flash" role="alert">{% for erreur in erreurs %}<p>{{ erreur }}</p>{% endfor %}</div>{% endif %}
    <form id="participant-form" method="post" class="participant-edit-form uniform-food-form">
        <input type="hidden" name="_token" value="{{ csrf_token('ajouter_participant') }}">
        <input type="hidden" name="type" value="{{ type }}">
        <fieldset><legend>Affectation</legend><label>Unité participante <b>*</b><select name="groupe_id" required>{% for groupe in groupes %}<option value="{{ groupe.id }}"{{ donnees.groupe_id == groupe.id ~ '' ? ' selected' : '' }}>{{ groupe.nom }}</option>{% endfor %}</select></label></fieldset>
        <fieldset><legend>Informations</legend>
            <div class="participant-form-grid"><label>Nom <b>*</b><input name="nom" maxlength="150" required value="{{ donnees.nom }}"></label><label>Prénom <b>*</b><input name="prenom" maxlength="150" required value="{{ donnees.prenom }}"></label><label>Date de naissance <b>*</b><input type="date" name="date_naissance" required value="{{ donnees.date_naissance }}"></label></div>
            {% if type == 'adulte' %}<div class="participant-form-grid participant-personal-contact"><label>Numéro de téléphone <b>*</b><input type="tel" name="telephone" maxlength="30" required value="{{ donnees.telephone }}"></label><label>Adresse e-mail <b>*</b><input type="email" name="email" maxlength="254" required value="{{ donnees.email }}"></label></div>{% endif %}
            <div class="participant-form-grid participant-dates"><label>Début de présence <b>*</b><input type="date" name="date_debut_presence" min="{{ sejour.dateDebut|date('Y-m-d') }}" max="{{ sejour.dateFin|date('Y-m-d') }}" required value="{{ donnees.date_debut_presence }}"></label><label>Fin de présence <b>*</b><input type="date" name="date_fin_presence" min="{{ sejour.dateDebut|date('Y-m-d') }}" max="{{ sejour.dateFin|date('Y-m-d') }}" required value="{{ donnees.date_fin_presence }}"></label></div>
        </fieldset>
        {% if type == 'jeune' %}
            <fieldset><legend>Contact des parents</legend><div class="participant-form-grid"><label>Téléphone 1 <b>*</b><input type="tel" name="telephone_parent_1" maxlength="30" required value="{{ donnees.telephone_parent_1 }}"></label><label>Téléphone 2<input type="tel" name="telephone_parent_2" maxlength="30" value="{{ donnees.telephone_parent_2 }}"></label><label>Adresse e-mail <b>*</b><input type="email" name="email_parents" maxlength="254" required value="{{ donnees.email_parents }}"></label></div></fieldset>
        {% else %}
            <fieldset><legend>Contact d’urgence</legend><div class="participant-form-grid"><label>Nom et prénom <b>*</b><input name="contact_urgence_nom_prenom" maxlength="300" required value="{{ donnees.contact_urgence_nom_prenom }}"></label><label>Téléphone <b>*</b><input type="tel" name="contact_urgence_telephone" maxlength="30" required value="{{ donnees.contact_urgence_telephone }}"></label></div></fieldset>
            <fieldset><legend>Formation</legend><div class="qualification-grid">{% for qualification in qualifications %}<label><input type="checkbox" name="qualifications[]" value="{{ qualification }}"{{ qualification in donnees.qualifications ? ' checked' : '' }}><span>{{ qualification }}</span></label>{% endfor %}</div><label>Précision de l’autre diplôme<input name="autre_diplome" maxlength="255" value="{{ donnees.autre_diplome }}"></label><label class="trainee-check"><input type="checkbox" name="stagiaire_bafa" value="1"{{ donnees.stagiaire_bafa ? ' checked' : '' }}> Stagiaire BAFA</label></fieldset>
        {% endif %}
        <footer><a href="{{ path('app_participants') }}">Annuler</a><button type="submit">Ajouter le participant</button></footer>
    </form>
</main>
{% endblock %}
