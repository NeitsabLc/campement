# Configuration Symfony sans secret.
# Copier ce fichier vers .env pour une installation locale.

APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share

DEFAULT_URI=http://localhost:8080
APP_PUBLIC_URL=http://localhost:8080

# DATABASE_URL est injectee par Docker Compose depuis le .env racine.

MESSENGER_TRANSPORT_DSN=sync://
MAILER_DSN=null://null
MAILER_FROM_EMAIL=no-reply@neitsab.net
MAILER_FROM_NAME=Campement
