{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env.*.local)",
      "Read(./.env.release)",
      "Read(./**/.env.release)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Read(./.env.recette)",
      "Read(./**/.env.recette)",
      "Read(./.ci.env)",
      "Read(./**/.ci.env)",
      "Read(./.release.env)",
      "Read(./**/deploy.env)",
      "Read(./secrets/**)",
      "Read(./**/secrets/**)",
      "Read(./private/**)",
      "Read(./**/private/**)",
      "Read(./**/secrets.yaml)",
      "Read(./**/.storage/**)",
      "Read(./**/acme.json)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./backups/**)",
      "Read(./**/backups/**)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)"
    ]
  }
}
