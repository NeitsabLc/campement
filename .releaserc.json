{
  "branches": [
    "main"
  ],
  "repositoryUrl": "https://gitlab.com/neitsablc/campement.git",
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "breaking": true,
            "release": "major"
          },
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "type": "fix",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "refactor",
            "release": "patch"
          },
          {
            "type": "security",
            "release": "patch"
          },
          {
            "type": "deps",
            "release": "patch"
          },
          {
            "type": "docs",
            "release": false
          },
          {
            "type": "test",
            "release": false
          },
          {
            "type": "build",
            "release": false
          },
          {
            "type": "ci",
            "release": false
          },
          {
            "type": "chore",
            "release": false
          },
          {
            "type": "style",
            "release": false
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "Fonctionnalités"
            },
            {
              "type": "fix",
              "section": "Corrections"
            },
            {
              "type": "perf",
              "section": "Performances"
            },
            {
              "type": "refactor",
              "section": "Refactorisation"
            },
            {
              "type": "deps",
              "section": "Dépendances"
            },
            {
              "type": "security",
              "section": "Sécurité"
            },
            {
              "type": "docs",
              "section": "Documentation",
              "hidden": false
            },
            {
              "type": "build",
              "section": "Construction",
              "hidden": true
            },
            {
              "type": "ci",
              "section": "Intégration continue",
              "hidden": true
            },
            {
              "type": "test",
              "section": "Tests",
              "hidden": true
            },
            {
              "type": "chore",
              "section": "Maintenance",
              "hidden": true
            }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogTitle": "# Historique des versions"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "./scripts/update-version.sh ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "version.txt",
          "app/config/services.yaml"
        ],
        "message": "chore: preparer la version ${nextRelease.version}\\n\\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/gitlab",
      {
        "successComment": false,
        "failComment": false
      }
    ]
  ]
}
