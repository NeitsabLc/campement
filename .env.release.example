# Copier ce fichier vers .env.release sur l'hôte de livraison.
# Remplacer chaque digest par celui publié et vérifié pour le même commit main.
CAMP_RELEASE_GIT_SHA=remplacer-par-le-sha-git-complet
CAMP_RELEASE_PHP_IMAGE=registry.gitlab.com/neitsablc/campement/php@sha256:remplacer-par-le-digest
CAMP_RELEASE_NGINX_IMAGE=registry.gitlab.com/neitsablc/campement/nginx@sha256:remplacer-par-le-digest
CAMP_RELEASE_POSTGRES_IMAGE=registry.gitlab.com/neitsablc/campement/postgres@sha256:remplacer-par-le-digest
CAMP_RELEASE_LIQUIBASE_IMAGE=registry.gitlab.com/neitsablc/campement/liquibase@sha256:remplacer-par-le-digest
CAMP_RELEASE_BACKUP_IMAGE=registry.gitlab.com/neitsablc/campement/backup@sha256:remplacer-par-le-digest
