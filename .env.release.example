CAMP_RELEASE_POSTGRES_IMAGE=ghcr.io/neitsablc/campement-app-postgres@sha256:remplacer-par-le-digest
CAMP_RELEASE_LIQUIBASE_IMAGE=ghcr.io/neitsablc/campement-app-liquibase@sha256:remplacer-par-le-digest
CAMP_RELEASE_BACKUP_IMAGE=ghcr.io/neitsablc/campement-app-backup@sha256:remplacer-par-le-digest
