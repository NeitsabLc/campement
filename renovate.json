{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "semanticCommitType": "deps",
  "schedule": ["before 6am on monday"],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "Regrouper les mises à jour mineures et correctives",
      "matchManagers": ["composer", "npm", "dockerfile", "gitlabci"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "dépendances mineures et correctives"
    },
    {
      "description": "Regrouper Playwright et Axe",
      "matchPackageNames": ["@playwright/test", "playwright-core", "@axe-core/playwright", "mcr.microsoft.com/playwright"],
      "groupName": "tests navigateur"
    },
    {
      "description": "Conserver les mises à jour majeures séparées",
      "matchUpdateTypes": ["major"],
      "groupName": null
    }
  ]
}
