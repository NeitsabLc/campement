COMPOSE_PROJECT_NAME=campement

# Secret Symfony obligatoire en production (générer une valeur aléatoire longue).
APP_SECRET=
DEFAULT_URI=http://localhost:8080
APP_PUBLIC_URL=http://localhost:8080
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=sync://

PHP_VERSION=8.4
PHP_IMAGE_DIGEST=sha256:9467f10bf42897dec0abb73ee20c747ebd45463ec9d6fcc4044cb83eba6dade7
NGINX_VERSION=1.29-alpine
NGINX_IMAGE_DIGEST=sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de
POSTGRES_VERSION=18-alpine
POSTGRES_IMAGE_DIGEST=sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15
LIQUIBASE_VERSION=5.0.3
LIQUIBASE_IMAGE_DIGEST=sha256:dfe136c26d39088d87d1bd27f833d6ac5b738a180d7c960b065c7be525725d01

POSTGRES_DB=campement
POSTGRES_USER=campement
POSTGRES_PASSWORD=
POSTGRES_HEALTHCHECK_USER=campement

# Rôles PostgreSQL dédiés utilisés par la surcharge de production.
POSTGRES_APP_USER=campement_app
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_USER=campement_migrator
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_BACKUP_USER=campement_backup
POSTGRES_BACKUP_PASSWORD=

POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5433
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HOST_PORT=8080

TRUSTED_PROXIES=127.0.0.1
TRUSTED_HOST_PATTERN=^(localhost|127\.0\.0\.1)$
