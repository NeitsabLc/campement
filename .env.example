COMPOSE_PROJECT_NAME=campement

PHP_VERSION=8.4
NGINX_VERSION=1.29-alpine
POSTGRES_VERSION=18-alpine
LIQUIBASE_VERSION=4.33.0

POSTGRES_DB=campement
